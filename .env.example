# Konfiguracja Metin2 Web & Mobile Client
# Jesli na serwerze istnieje /opt/metin2/linux-port/docker/.env lub /opt/metin2/.env,
# instalator (install.sh) oraz backend automatycznie wykryja haslo do bazy MariaDB!

# Adres IP Twojego serwera VPS (wykrywany automatycznie przez install.sh)
PUBLIC_IP=YOUR_VPS_IP

# Porty HTTP dla klienta webowego (Nginx)
WEB_HTTP_PORT=80
WEB_ALT_PORT=8080

# Dane dostepowe do bazy danych MariaDB (Metin2 Singleplayer)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD

# Wewnetrzne porty uslug (zazwyczaj nie wymagaja zmiany)
BRIDGE_PORT=11496
REG_API_PORT=11497
