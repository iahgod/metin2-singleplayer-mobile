class Clickable(ui.Bar):
    """A coloured rectangle that answers the mouse: rows, tiles and chips.
    Its callbacks are weak (ui.__mem_func__): a strong one would hold the
    window from every row, and ui.Window's __del__ keeps such a cycle from
    Python 2.7's collector."""

    def __init__(self, color, overColor=None):
        ui.Bar.__init__(self)
        self.color, self.overColor, self.selected = color, overColor, False
        self.onClick = self.onOver = self.onOut = None
        self.SetColor(color)

    def SetClick(self, method, args=()):
        self.onClick = (ui.__mem_func__(method), args) if method else None

    def SetOver(self, method, args=()):
        self.onOver = (ui.__mem_func__(method), args) if method else None

    def SetOut(self, method, args=()):
        self.onOut = (ui.__mem_func__(method), args) if method else None

    def Select(self, selected, selectedColor):
        self.selected = selected
        self.SetColor(selectedColor if selected else self.color)
        self.selectedColor = selectedColor

    def OnMouseOverIn(self):
        if self.overColor is not None and not self.selected:
            self.SetColor(self.overColor)
        if self.onOver:
            self.onOver[0](*self.onOver[1])

    def OnMouseOverOut(self):
        if self.overColor is not None and not self.selected:
            self.SetColor(self.color)
        if self.onOut:
            self.onOut[0](*self.onOut[1])

    def OnMouseLeftButtonUp(self):
        if self.onClick:
            self.onClick[0](*self.onClick[1])
        return True


class WikiModelPreview(ui.Window):
    def __init__(self):
        ui.Window.__init__(self)
        self.index = -1
        self.rotation = True
        self.zoomSteps = 0

    def RegisterWindow(self, layer):
        self.hWnd = wndMgr.RegisterRenderTarget(self, layer)

    def Select(self, vnum):
        self.index = renderTarget.GetFreeIndex(100, 200)
        if not wndMgr.SetRenderTarget(self.hWnd, self.index):
            self.index = -1
            return False
        renderTarget.SetVisibility(self.index, True)
        renderTarget.SelectModel(self.index, vnum)
        renderTarget.SetRotation(self.index, True)
        return bool(renderTarget.HasModel(self.index))

    def Zoom(self, direction):
        step = self.zoomSteps + direction
        if -5 <= step <= 5 and self.index >= 0:
            renderTarget.Zoom(self.index, direction)
            self.zoomSteps = step

    def Rotate(self):
        self.rotation = not self.rotation
        if self.index >= 0:
            renderTarget.SetRotation(self.index, self.rotation)

    def Release(self):
        if self.index >= 0:
            renderTarget.Remove(self.index)
            self.index = -1
        self.Hide()


class EncyclopediaofGame(ui.BoardWithTitleBar):
    def __init__(self):
        ui.BoardWithTitleBar.__init__(self)
        self.AddFlag('movable')
        self.AddFlag('float')
        self.SetTitleName('Wikipedia by Kiciamol')
        self.SetCloseEvent(ui.__mem_func__(self.Close))
        self.widgets, self.resultWidgets, self.detailWidgets, self.headWidgets = [], [], [], []
        self.chips, self.sideRows = [], []
        self.category, self.job, self.levelBand, self.offset, self.detailOffset = 11, -1, 0, 0, 0
        self.sortByLevel = True
        self.records, self.detailEntries, self.history = [], [], []
        self.selected = None
        self.sizeIndex = DEFAULT_SIZE
        self.busy = False
        self.tableMode = False
        self.tooltip = None
        self.counts = None
        self.detailTop = 0
        self.detailPageSize = 1
        # Scrolling (Kiciamol, 10 October: the FPS fell while the bar was
        # dragged). The bar calls its event on every mouse move, several times
        # a frame, and each call rebuilt the whole list - a hundred and more
        # windows made and dropped, a TextLine measured letter by letter for
        # every name. Now a call only notes the new offset; OnUpdate draws it
        # at most 30 times a second independently of the game's FPS cap,
        # nothing when the displayed offset did not change. The final pending
        # position is retained until it is drawn. Fit remembers its measures.
        self.pendingResults = False
        self.pendingDetails = False
        self.drawnResultsOffset = None
        self.drawnDetailsOffset = None
        self.nextScrollDraw = 0.0
        self.equipmentRecords = None
        self.equipmentColumns = []
        self.equipmentMaterialRows = 2
        self.fitCache = {}
        self.measure = None
        self.Build()
        self.Search()
        self.Hide()


    def Keep(self, widget, parent, x, y, collection=None):
        widget.SetParent(parent)
        widget.SetPosition(x, y)
        widget.Show()
        (self.widgets if collection is None else collection).append(widget)
        return widget

    def Text(self, x, y, text, collection=None, color=TEXT, parent=None, font=None, pick=False):
        label = self.Keep(ui.TextLine(), parent or self, x, y, collection)
        if font:
            label.SetFontName(font)
        label.SetText(text)
        label.SetPackedFontColor(color)
        if not pick:
            label.AddFlag('not_pick')
        return label

    def Rect(self, x, y, w, h, color, collection=None, parent=None, edge=None):
        bar = self.Keep(ui.Bar(), parent or self, x, y, collection)
        bar.SetSize(w, h)
        bar.SetColor(color)
        bar.AddFlag('not_pick')
        if edge is not None:
            box = self.Keep(ui.Box(), parent or self, x, y, collection)
            box.SetSize(w, h)
            box.SetColor(edge)
            box.AddFlag('not_pick')
        return bar

    def Image(self, x, y, path, collection=None, parent=None, w=None, h=None, keepRatio=False):
        image = self.Keep(ui.ExpandedImageBox(), parent or self, x, y, collection)
        image.AddFlag('not_pick')
        image.LoadImage(path)
        iw, ih = image.GetWidth(), image.GetHeight()
        if w and h and iw and ih:
            sx, sy = float(w) / iw, float(h) / ih
            if keepRatio:
                sx = sy = min(sx, sy, 1.0)
            image.SetScale(sx, sy)
        return image

    def Icon(self, vnum, x, y, size, collection, parent=None):
        if not item.SelectItemWiki(vnum):
            return None
        icon = self.Image(x, y, item.GetIconImageFileName(), collection, parent)
        w, h = icon.GetWidth(), icon.GetHeight()
        scale = min(1.0, float(size) / max(1, w), float(size) / max(1, h))
        icon.SetScale(scale, scale)
        icon.SetPosition(x + (size - int(w * scale)) // 2, y + (size - int(h * scale)) // 2)
        return icon

    def Button(self, x, y, label, callback, args=(), collection=None, wide=False):
        button = self.Keep(ui.Button(), self, x, y, collection)
        size = 'xlarge' if wide else 'large'
        for setter, state in ((button.SetUpVisual, '01'), (button.SetOverVisual, '02'), (button.SetDownVisual, '03')):
            setter('d:/ymir work/ui/public/%s_button_%s.sub' % (size, state))
        button.SetText(label)
        button.SetEvent(ui.__mem_func__(callback), *args)
        return button

    def Click(self, x, y, w, h, color, overColor, callback, args=(), collection=None, parent=None, edge=None):
        bar = self.Keep(Clickable(color, overColor), parent or self, x, y, collection)
        bar.SetSize(w, h)
        bar.SetClick(callback, args)
        if edge is not None:
            box = self.Keep(ui.Box(), parent or self, x, y, collection)
            box.SetSize(w, h)
            box.SetColor(edge)
            box.AddFlag('not_pick')
        return bar

    def Fit(self, text, width):
        key = (text, width)
        cached = self.fitCache.get(key)
        if cached is not None:
            return cached
        if self.measure is None:
            self.measure = ui.TextLine()
        label = self.measure
        label.SetText(text)
        if label.GetTextSize()[0] > width:
            
            
            low, high = 0, len(text)
            while low < high:
                middle = (low + high + 1) // 2
                label.SetText(text[:middle] + '...')
                if label.GetTextSize()[0] <= width:
                    low = middle
                else:
                    high = middle - 1
            result = text[:low] + '...'
        else:
            result = text
        if len(self.fitCache) > 4000:
            self.fitCache.clear()
        self.fitCache[key] = result
        return result

    def Clear(self, collection):
        for widget in collection:
            if isinstance(widget, WikiModelPreview):
                widget.Release()
            widget.Hide()
        del collection[:]


    def Build(self):
        screenW, screenH = wndMgr.GetScreenWidth(), wndMgr.GetScreenHeight()
        width, height = SIZES[self.sizeIndex]
        while self.sizeIndex > 0 and (width > screenW - 20 or height > screenH - 40):
            self.sizeIndex -= 1
            width, height = SIZES[self.sizeIndex]
        width, height = min(width, screenW - 20), min(height, screenH - 40)
        self.SetSize(width, height)
        self.SetCenterPosition()
        self.x0 = 18 + SIDE_W
        self.cw = width - self.x0 - 10
        self.top = 34
        self.listTop = self.top + 64 + 8 + 26 + 8
        self.bottom = height - 34
        self.listW = max(LIST_W, int(self.cw * 0.36))
        self.detailX = self.x0 + self.listW + 8
        self.detailW = width - 10 - self.detailX


        self.Rect(10, self.top, SIDE_W, self.bottom - self.top, PANEL, edge=PANEL_EDGE)
        self.sideRows = []
        y = self.top + 6
        self.Text(20, y, T('WIKI_SECTION_ITEMS', 'PRZEDMIOTY', 'ITEMS'), color=DIM)
        y += 18
        keys = wikiui.CategoryKeys()
        for index, key in enumerate(keys):
            if index == 10:
                y += 6
                self.Text(20, y, T('WIKI_SECTION_WORLD', '\x8cWIAT', 'WORLD'), color=DIM)
                y += 18
            row = self.Click(11, y, SIDE_W - 2, 26, 0x00000000, ROW_OVER, self.SelectCategory, (index,))
            accent = self.Rect(11, y, 3, 26, ACCENT)
            accent.Hide()
            if index >= 10:
                kind, rank = {10: (0, 0), 11: (0, 4), 12: (2, 0)}[index]
                picture = {10: Portrait(101), 12: Portrait(8001)}.get(index) or Badge(kind, rank)
                self.Image(20, y + 2, picture, w=20, h=22 if index != 11 else 24)
            else:
                self.Icon(CATEGORY_ICONS.get(index, 0), 20, y + 3, 20, self.widgets)
            # Labels of long categories are measured and abbreviated by Fit.
            label = self.Text(48, y + 6, self.Fit(getattr(localeInfo, key), SIDE_W - 86))
            count = self.Text(10 + SIDE_W - 8, y + 6, '', color=DIM)
            count.SetHorizontalAlignRight()
            self.sideRows.append((row, accent, label, count))
            y += 27


        self.Rect(self.x0, self.top, self.cw, 64, 0xff0c0a07, edge=PANEL_EDGE)
        banner = self.Image(self.x0 + 1, self.top + 1, 'wiki_theme_c/banner.tga')
        bw, bh = banner.GetWidth(), banner.GetHeight()
        banner.SetScale(float(self.cw - 2) / max(1, bw), 50.0 / max(1, bh))
        banner.SetPosition(self.x0 + 1, self.top + 1)
        self.crumbs = self.Text(self.x0 + 8, self.top + 51, '', color=0xffe8e0cc)
        self.crumbs.SetOutline()


        barY = self.top + 72
        self.Rect(self.x0, barY, 250, 26, 0xff070707, edge=PANEL_EDGE)
        self.Image(self.x0 + 250 - 116, barY, IMG + 'search_slot.tga')
        self.query = self.Keep(ui.EditLine(), self, self.x0 + 8, barY + 6)
        self.query.SetSize(120, 18)
        self.query.SetMax(64)
        self.query.SetReturnEvent(ui.__mem_func__(self.Search))
        self.queryHint = self.Text(self.x0 + 8, barY + 6, T('WIKI_SEARCH_HINT', 'Szukaj...', 'Search...'), color=DIM)
        self.Click(self.x0 + 250 - 28, barY + 2, 26, 22, 0x00000000, 0x30ffffff, self.Search)
        self.chipX, self.chipY = self.x0 + 258, barY + 1
        self.chips = []
        self.sortLabel = self.Text(self.x0 + self.cw - 4, barY + 6, '', pick=True)
        self.sortLabel.SetHorizontalAlignRight()
        self.sortLabel.SetSize(220, 16)
        self.sortLabel.SetEvent('MOUSE_LEFT_BUTTON_UP', ui.__mem_func__(self.ToggleSort))


        listH = self.bottom - self.listTop
        self.listPanel = self.Image(self.x0, self.listTop, IMG + 'result_wall.tga', w=self.listW, h=listH)
        self.Rect(self.x0, self.listTop, self.listW, listH, 0x00000000, edge=PANEL_EDGE)
        self.detailPanel = self.Image(self.detailX, self.listTop, IMG + 'result_wall.tga', w=self.detailW, h=listH)
        self.Rect(self.detailX, self.listTop, self.detailW, listH, 0x00000000, edge=PANEL_EDGE)
        self.pageSize = max(1, (listH - 4) // ROW_H)

        self.resultScroll = self.Keep(ui.ScrollBar(), self, self.x0 + self.listW - 18, self.listTop + 2)
        self.resultScroll.SetScrollBarSize(listH - 4)
        self.resultScroll.SetScrollEvent(ui.__mem_func__(self.ScrollResults))
        self.detailScroll = self.Keep(ui.ScrollBar(), self, self.detailX + self.detailW - 18, self.listTop + 2)
        self.detailScroll.SetScrollBarSize(listH - 4)
        self.detailScroll.SetScrollEvent(ui.__mem_func__(self.ScrollDetails))


        self.status = None
        self.Text(14, height - 23, T('WIKI_FOOTER',
                                     'Szanse bazowe z plik\xf3w serwera \xb7 Ctrl+Alt+PPM otwiera stron\xea w przegl\xb9darce',
                                     'Base chances from the server files - Ctrl+Alt+RMB opens the page in the browser'),
                  color=DIM)
        plus = self.SmallButton(width - 52, height - 29, '+', self.ChangeSize, (1,))
        minus = self.SmallButton(width - 52 - 46, height - 29, '-', self.ChangeSize, (-1,))
        if self.sizeIndex == len(SIZES) - 1 or SIZES[min(len(SIZES) - 1, self.sizeIndex + 1)][0] > screenW - 20:
            plus.Disable()
        if self.sizeIndex == 0:
            minus.Disable()
        self.Button(width - 52 - 46 - 94, height - 30, T('WIKI_BACK', 'Wstecz', 'Back'), self.Back)

    def SmallButton(self, x, y, label, callback, args=()):
        button = self.Keep(ui.Button(), self, x, y)
        for setter, state in ((button.SetUpVisual, '01'), (button.SetOverVisual, '02'), (button.SetDownVisual, '03'),
                              (button.SetDisableVisual, '03')):
            setter('d:/ymir work/ui/public/small_button_%s.sub' % state)
        button.SetText(label)
        button.SetEvent(ui.__mem_func__(callback), *args)
        return button

    def DrawChips(self):
        self.Clear(self.chips)
        if self.category >= 10:
            labels = [T('WIKI_ALL', 'Wszystkie', 'All'), '1-30', '31-60', '61-90', '91+']
            current = self.levelBand
            callback = self.SelectBand
        else:
            labels = [T('WIKI_ALL', 'Wszystkie', 'All'), localeInfo.WIKI_JOB_WARRIOR, localeInfo.WIKI_JOB_ASSASSIN,
                      localeInfo.WIKI_JOB_SURA, localeInfo.WIKI_JOB_SHAMAN]
            current = self.job + 1
            callback = self.SelectJob
        x = self.chipX
        limit = self.x0 + self.cw - 200
        for index, label in enumerate(labels):
            measure = ui.TextLine()
            measure.SetText(label)
            w = measure.GetTextSize()[0] + 16
            if x + w > limit:
                break
            on = index == current
            chip = self.Click(x, self.chipY, w, 24, 0xff16130f, 0xff221c14, callback, (index,), self.chips,
                              edge=0xffc9a050 if on else 0xff3e3426)
            if on:
                chip.Select(True, 0xff2a2116)
            self.Text(x + 8, self.chipY + 5, label, self.chips, GOLD if on else 0xffbfb49c)
            x += w + 6
        self.sortLabel.SetText((localeInfo.WIKI_RESULTS % len(self.records)) + '   ' +
                               T('WIKI_SORT', 'Sortuj:', 'Sort:') + ' ' +
                               (T('WIKI_SORT_LEVEL', 'poziom', 'level') if self.sortByLevel else
                                T('WIKI_SORT_NAME', 'nazwa', 'name')))

    def RefreshSide(self):
        if self.counts is None:
            self.counts = {}
            for index in range(10):
                self.counts[index] = sum(1 for vnum in catalog.ITEMS if wikiui.AcceptItem(vnum, index)
                                         and not (index == 0 and IsNoName(wikiui.ItemName(vnum))))
            self.counts[7] = 0
            self.counts[8] = len(AlchemyRecords(''))
            for vnum, (kind, rank, level) in catalog.MOBS.items():
                index = 12 if kind == 2 else (11 if rank >= 4 else 10) if kind == 0 else None
                if index is not None and not IsNoName(wikiui.MobName(vnum)):
                    self.counts[index] = self.counts.get(index, 0) + 1
        for index, (row, accent, label, count) in enumerate(self.sideRows):
            on = index == self.category
            row.Select(on, ROW_ON)
            if on:
                accent.Show()
            else:
                accent.Hide()
            label.SetPackedFontColor(GOLD if on else 0xffcfc6b2)
            count.SetText(Money(self.counts.get(index, 0)) if self.counts.get(index) else '')


    def Search(self):
        if self.query.GetText():
            self.queryHint.Hide()
        else:
            self.queryHint.Show()
        if self.category == 7:
            self.ShowUnavailable()
            return
        if self.category == 8:
            records = AlchemyRecords(self.query.GetText())
        else:
            records = wikiui.Records(self.category, self.query.GetText(), self.job if self.category < 10 else -1)
        records = [row for row in records if not IsNoName(row[2])]
        self.tableMode = self.category in (1, 2, 3, 4, 5)
        if self.tableMode:
            families, unique = set(), []
            for kind, vnum, name in records:
                family = wikiui.EquipmentFamily(vnum)
                if family not in families:
                    families.add(family)
                    unique.append((kind, family, wikiui.ItemName(family)))
            records = unique
        if self.category >= 10 and self.levelBand:
            low, high = ((1, 30), (31, 60), (61, 90), (91, 999))[self.levelBand - 1]
            records = [row for row in records if low <= catalog.MOBS[row[1]][2] <= high]
        if self.sortByLevel:
            if self.category >= 10:
                records.sort(key=lambda row: catalog.MOBS[row[1]][2])
            else:
                levels = dict((row[1], wikiui.EquipmentLevel(row[1]) or 0) for row in records)
                records.sort(key=lambda row: levels[row[1]])
        self.records = records
        self.offset = 0
        self.SetScrollPos(self.resultScroll, 0)
        self.RefreshSide()
        self.DrawChips()
        mismatch = self.selected is None or (self.selected[0] == 'mob') != (self.category >= 10)
        if not self.tableMode and records and (mismatch or not self.headWidgets):
            if mismatch:
                self.selected = None
                self.SelectRecord(records[0][0], records[0][1], False)
            else:
                self.SelectRecord(self.selected[0], self.selected[1], False)
            return
        self.DrawResults()
        self.UpdateCrumbs()

    def ShowUnavailable(self):
        # Costumes are switched off for now (Kiciamol, 9 October).
        self.records, self.tableMode, self.selected = [], False, None
        self.offset = 0
        self.SetScrollPos(self.resultScroll, 0)
        self.RefreshSide()
        self.DrawChips()
        self.DrawResults()
        self.Clear(self.headWidgets)
        self.Clear(self.detailWidgets)
        self.detailEntries = []
        self.detailScroll.Hide()
        title = self.Text(self.detailX + 20, self.listTop + 24,
                          T('WIKI_UNAVAILABLE_TITLE', 'Niedost\xeapne', 'Unavailable'), self.headWidgets, GOLD,
                          font=gamefont.GetCurrentFontLarge())
        title.SetOutline()
        self.Text(self.detailX + 20, self.listTop + 52,
                  T('WIKI_UNAVAILABLE_TEXT', 'Sekcja Kostiumy jest na razie niedost\xeapna.',
                    'The Costumes section is not available yet.'), self.headWidgets, TEXT)
        self.UpdateCrumbs()

    def UpdateCrumbs(self):
        parts = ['Wiki', getattr(localeInfo, wikiui.CategoryKeys()[self.category])]
        if self.selected and not self.tableMode:
            kind, vnum = self.selected
            parts.append(wikiui.ItemName(vnum) if kind == 'item' else wikiui.MobName(vnum))
        self.crumbs.SetText('  >  '.join(parts))

    def Reset(self):
        self.query.SetText('')
        self.Search()

    def SelectCategory(self, category):
        if category != self.category:
            self.category = category
            self.levelBand = 0
        self.Search()

    def SelectJob(self, index):
        self.job = index - 1
        self.Search()

    def SelectBand(self, index):
        self.levelBand = index
        self.Search()

    def ToggleSort(self):
        self.sortByLevel = not self.sortByLevel
        self.Search()


    def DrawResults(self):
        self.pendingResults = False
        self.Clear(self.resultWidgets)
        if self.tableMode:
            self.ShowPanels(False)
            self.DrawEquipment()
            return
        self.ShowPanels(True)
        self.pageSize = max(1, (self.bottom - self.listTop - 4) // ROW_H)
        count = len(self.records)
        self.offset = max(0, min(self.offset, max(0, count - self.pageSize)))
        self.drawnResultsOffset = self.offset
        self.ResizeScrollThumb(self.resultScroll, min(0.9, float(self.pageSize) / max(1, count)))
        self.resultScroll.SetPosition(self.x0 + self.listW - 18, self.listTop + 2)
        if count > self.pageSize:
            self.resultScroll.Show()
        else:
            self.resultScroll.Hide()
        width = self.listW - (22 if count > self.pageSize else 4)
        for index, (kind, vnum, name) in enumerate(self.records[self.offset:self.offset + self.pageSize]):
            y = self.listTop + 2 + index * ROW_H
            on = self.selected == (kind, vnum)
            row = self.Click(self.x0 + 2, y, width, ROW_H - 1, 0x00000000, ROW_OVER, self.SelectRecord, (kind, vnum), self.resultWidgets)
            row.Select(on, ROW_ON)
            self.Rect(self.x0 + 2, y + ROW_H - 1, width, 1, 0xff1f1b15, self.resultWidgets)
            if on:
                self.Rect(self.x0 + 2, y, 3, ROW_H - 1, ACCENT, self.resultWidgets)
            nameWidth = width - 52
            if kind == 'mob':
                mobKind, rank, level = catalog.MOBS[vnum]
                self.Rect(self.x0 + 7, y + 4, 34, 34, 0xff100e0b, self.resultWidgets, edge=0xff7b6440 if on else 0xff4d402a)
                self.Image(self.x0 + 8, y + 5, MobPicture(vnum, mobKind, rank), self.resultWidgets, w=32, h=32, keepRatio=False)
                sub = T('WIKI_LEVEL_SHORT', 'Poziom %d', 'Level %d') % level
                tag, tagColor = RankLabel(mobKind, rank)
                if tag:
                    tagW = len(tag) * 7 + 8
                    self.Rect(self.x0 + width - tagW - 4, y + 13, tagW, 15, 0xc0100c08, self.resultWidgets, edge=tagColor & 0x80ffffff | 0x80000000)
                    self.Text(self.x0 + width - tagW, y + 14, tag, self.resultWidgets, tagColor)
                    nameWidth -= tagW + 4
            else:
                self.Image(self.x0 + 6, y + 3, IMG + 'slot/empty_slot.tga', self.resultWidgets, w=36, h=36)
                self.Icon(vnum, self.x0 + 8, y + 5, 32, self.resultWidgets)
                level = wikiui.EquipmentLevel(vnum)
                sub = (T('WIKI_LEVEL_SHORT', 'Poziom %d', 'Level %d') % level) if level else '#%d' % vnum
            self.Text(self.x0 + 46, y + 6, self.Fit(name, nameWidth), self.resultWidgets, 0xffead7a6)
            self.Text(self.x0 + 46, y + 22, sub, self.resultWidgets, GREY)
            if kind == 'item':
                row.SetOver(self.ShowTooltip, (vnum,))
                row.SetOut(self.HideTooltip)

    def ShowPanels(self, show):
        for widget in (self.listPanel, self.detailPanel):
            if show:
                widget.Show()
            else:
                widget.Hide()
        if not show:
            self.Clear(self.detailWidgets)
            self.Clear(self.headWidgets)
            self.detailScroll.Hide()

    def DrawEquipment(self):
        # The author's upgrade table, moved into the new frame.
        # Native recipes are a static client snapshot. A search replaces the
        # record list; scrolling and resizing that list do not change recipes.
        if self.equipmentRecords is not self.records:
            self.equipmentRecords = self.records
            self.equipmentColumns = [wikiui.EquipmentColumns(row[1]) for row in self.records]
            self.equipmentMaterialRows = min(5, max([2] + [len(materials)
                for family in self.equipmentColumns for vnum, materials, cost in family]))
        columns = self.equipmentColumns
        materialRows = self.equipmentMaterialRows
        rowHeight = {2: 156, 3: 200, 4: 244, 5: 296}[materialRows]
        top0 = self.listTop
        self.pageSize = max(1, (self.bottom - top0) // (rowHeight + 12))
        self.offset = max(0, min(self.offset, max(0, len(self.records) - self.pageSize)))
        self.drawnResultsOffset = self.offset
        self.resultScroll.SetPosition(self.x0 + self.cw - 18, top0)
        self.ResizeScrollThumb(self.resultScroll, min(0.9, float(self.pageSize) / max(1, len(self.records))))
        if len(self.records) > self.pageSize:
            self.resultScroll.Show()
        else:
            self.resultScroll.Hide()
        left0 = self.x0
        width = self.cw - 22
        scale = float(width) / 541
        for rowIndex, (kind, family, name) in enumerate(self.records[self.offset:self.offset + self.pageSize]):
            top = top0 + rowIndex * (rowHeight + 12)
            self.Image(left0, top, IMG + 'slot/slot_%d.tga' % materialRows, self.resultWidgets, w=width, h=rowHeight)
            self.Text(left0 + 6, top + 4, self.Fit(name, width - 132), self.resultWidgets, 0xffffdd99)
            level = wikiui.EquipmentLevel(family)
            if level is not None:
                self.Text(left0 + width - 104, top + 4, self.Fit(localeInfo.WIKI_LEVEL_MOB_TEXT % level, 100), self.resultWidgets)
            self.Text(left0 + int(10 * scale), top + 24, self.Fit(localeInfo.WIKI_UPGRADE_COSTS, int(113 * scale)), self.resultWidgets)
            self.Text(left0 + int(50 * scale), top + 140 + 44 * (materialRows - 2),
                      self.Fit(getattr(localeInfo, 'WIKI_YANG_COSTS', 'Yang'), int(77 * scale)), self.resultWidgets)
            if item.SelectItemWiki(family):
                icon = self.Keep(ui.ExpandedImageBox(), self, left0 + 6, top + 56, self.resultWidgets)
                icon.LoadImage(item.GetIconImageFileName())
                size = min(1.0, 80.0 / max(1, icon.GetHeight()), 64.0 / max(1, icon.GetWidth()))
                icon.SetScale(size, size)
                icon.SAFE_SetStringEvent('MOUSE_OVER_IN', self.ShowTooltip, family)
                icon.SAFE_SetStringEvent('MOUSE_OVER_OUT', self.HideTooltip)
            for grade, (vnum, materials, cost) in enumerate(columns[self.offset + rowIndex]):
                left = left0 + int((130 + grade * 41) * scale)
                cellWidth = int(41 * scale)
                label = self.Text(left + 7, top + 24, '+%d' % (vnum % 10), self.resultWidgets, pick=True)
                label.SetSize(cellWidth - 8, 18)
                label.SetEvent('MOUSE_LEFT_BUTTON_UP', ui.__mem_func__(self.SelectRecord), 'item', vnum)
                label.SetEvent('MOUSE_OVER_IN', ui.__mem_func__(self.ShowTooltip), vnum)
                label.SetEvent('MOUSE_OVER_OUT', ui.__mem_func__(self.HideTooltip))
                for index, (material, count) in enumerate(materials):
                    if not item.SelectItemWiki(material):
                        continue
                    icon = self.Keep(ui.ExpandedImageBox(), self, left + max(1, (cellWidth - 32) // 2), top + 46 + index * 44, self.resultWidgets)
                    icon.LoadImage(item.GetIconImageFileName())
                    size = min(1.0, 32.0 / max(1, icon.GetHeight()), 32.0 / max(1, icon.GetWidth()))
                    icon.SetScale(size, size)
                    icon.SAFE_SetStringEvent('MOUSE_OVER_IN', self.ShowTooltip, material)
                    icon.SAFE_SetStringEvent('MOUSE_OVER_OUT', self.HideTooltip)
                    self.Text(left + 4, top + 77 + index * 44, self.Fit('x%d' % count, cellWidth - 6), self.resultWidgets)
                if not materials:
                    self.Text(left + cellWidth // 2 - 3, top + 62, '-', self.resultWidgets)
                self.Text(left + 3, top + 140 + 44 * (materialRows - 2),
                          self.Fit('-' if grade == 0 else wikiui.ShortMoney(cost), cellWidth - 6), self.resultWidgets)

    def ScrollResults(self):
        if self.busy:
            return
        offset = int(round(self.resultScroll.GetPos() * max(0, len(self.records) - self.pageSize)))
        if offset != self.offset:
            self.offset = offset
            self.pendingResults = True

    def ResizeScrollThumb(self, scroll, scale):
        
        
        if getattr(scroll, 'wikiScale', None) == scale:
            return
        scroll.wikiScale = scale
        busy, self.busy = self.busy, True
        scroll.LockScroll()
        try:
            scroll.SetMiddleBarSize(scale)
        finally:
            scroll.UnlockScroll()
            self.busy = busy

    def SetScrollPos(self, scroll, pos):
        busy, self.busy = self.busy, True
        try:
            scroll.SetPos(pos)
        finally:
            self.busy = busy


    def SelectRecord(self, kind, vnum, remember=True):
        if kind == 'item' and not KnownItem(vnum) or kind == 'mob' and vnum not in catalog.MOBS:
            return
        if remember and self.selected and self.selected != (kind, vnum):
            self.history.append(self.selected)
            self.history = self.history[-32:]
        if self.tableMode:
            self.tableMode = False
            listH = self.bottom - self.listTop
            self.pageSize = max(1, (listH - 4) // ROW_H)
        self.selected = kind, vnum
        self.detailOffset = 0
        self.detailEntries = []
        self.DrawHead()
        self.detailEntries = self.MobEntries(vnum) if kind == 'mob' else self.ItemEntries(vnum)
        self.SetScrollPos(self.detailScroll, 0)
        self.detailOffset = 0
        self.DrawDetails()
        self.DrawResults()
        self.UpdateCrumbs()

    def DrawHead(self):
        self.Clear(self.headWidgets)
        kind, vnum = self.selected
        x, y, c = self.detailX + 14, self.listTop + 12, self.headWidgets
        preview3D = kind == 'mob' and renderTarget is not None
        self.Image(x, y, IMG + 'render_back.tga', c, w=124 if preview3D else 74, h=150 if preview3D else 96)
        self.Rect(x, y, 124 if preview3D else 74, 150 if preview3D else 96, 0x00000000, c, edge=0xff6b5a3a)
        nameX = x + (138 if preview3D else 88)
        textW = self.detailW - (138 if preview3D else 88) - 40
        if kind == 'mob':
            mobKind, rank, level = catalog.MOBS[vnum]
            preview = None
            if preview3D:
                preview = self.Keep(WikiModelPreview(), self, x + 2, y + 2, c)
                preview.SetSize(120, 146)
                if not preview.Select(vnum):
                    preview.Release()
                    preview = None
            if preview is None:
                portrait = IMG + 'portraits/%d.tga' % vnum
                if pack.Exist(portrait):
                    self.Image(x + 4, y + 4, portrait, c, w=66, h=88, keepRatio=False)
                else:
                    self.Image(x + 16, y + 17, Badge(mobKind, rank), c, w=42, h=62)
            else:
                for label, dx, callback, args in (
                        ('+', 0, preview.Zoom, (-1,)),
                        ('-', 34, preview.Zoom, (1,)),
                        ('<>', 68, preview.Rotate, ())):
                    self.Click(x + dx, y + 154, 30, 18, 0xff30261a, 0xff58432a,
                               callback, args, c, edge=PANEL_EDGE)
                    self.Text(x + dx + 9, y + 155, label, c, GOLD)
            name = wikiui.MobName(vnum)
            tags = [RankLabel(mobKind, rank), ('#%d' % vnum, 0xffc8bca4)]
            gold = nonplayer.GetMonsterPrice(vnum)
            stats = [(T('WIKI_STAT_LEVEL', 'Poziom', 'Level'), str(nonplayer.GetMonsterLevel(vnum))),
                     (T('WIKI_STAT_HP', 'P\xaf', 'HP'), Money(nonplayer.GetMonsterMaxHP(vnum))),
                     (T('WIKI_STAT_EXP', 'Do\x9cw.', 'Exp'), Money(nonplayer.GetMonsterExp(vnum))),
                     (T('WIKI_STAT_YANG', 'Yang', 'Yang'), '%s-%s' % (wikiui.ShortMoney(gold[0]), wikiui.ShortMoney(gold[1])))]
            maps = MapNames(vnum)
        else:
            self.Icon(vnum, x + 13, y + 24, 48, c)
            name = wikiui.ItemName(vnum)
            if IsDragonStone(vnum):
                name = '%s (%s)' % (name, StepText((vnum // 100) % 10 + 1))
            item.SelectItemWiki(vnum)
            typeKey = ITEM_TYPES.get(item.GetItemType())
            tags = [(T(typeKey, ITEM_TYPE_TEXT[typeKey][0], ITEM_TYPE_TEXT[typeKey][1]), 0xffc8bca4)] if typeKey else []
            tags.append(('#%d' % vnum, 0xffc8bca4))
            level = wikiui.EquipmentLevel(vnum)
            stats = [(T('WIKI_STAT_LEVEL', 'Poziom', 'Level'), str(level) if level else '-')]
            sources = catalog.SOURCES.get(vnum, ())
            stats.append((T('WIKI_STAT_SOURCES', '\x8fr\xf3d\xb3a', 'Sources'), str(len(sources))))
            maps = []
        title = self.Text(nameX, y, self.Fit(name, textW), c, GOLD, font=gamefont.GetCurrentFontLarge())
        title.SetOutline()
        tx = nameX
        for tag, color in tags:
            if not tag:
                continue
            measure = ui.TextLine()
            measure.SetText(tag)
            w = measure.GetTextSize()[0] + 10
            self.Rect(tx, y + 24, w, 16, 0xc0100c08, c, edge=(color & 0x00ffffff) | 0x90000000)
            self.Text(tx + 5, y + 25, tag, c, color)
            tx += w + 5
        for index, (label, value) in enumerate(stats):
            sx = nameX + (index % 2) * (textW // 2)
            sy = y + 48 + (index // 2) * 16
            self.Text(sx, sy, label, c, GREY)
            self.Text(sx + 58, sy, value, c, 0xffe8e0cc)
        if maps:
            line = T('WIKI_LIVES_ON', 'Wyst\xeapuje:', 'Found on:') + ' '
            self.Text(nameX, y + 84, line, c, GREY)
            self.Text(nameX + 62, y + 84, self.Fit(', '.join(maps), textW - 62), c, LINK)
        self.Image(self.detailX + 14, self.listTop + (186 if preview3D else 118), IMG + 'divider_long.tga', c, w=self.detailW - 40, h=1)
        self.detailTop = self.listTop + (194 if preview3D else 126)

    def MobEntries(self, vnum):
        entries = []
        if extra:


            rows = sorted(extra.DROP.get(vnum, ()), key=lambda row: -row[2])
            tiles = [('item', v, n, p) for v, n, p in rows]
        else:
            tiles = [('item', v, n, None) for v, n in catalog.MOB_DROP.get(vnum, ())]
        entries.append(('head', T('WIKI_DROP', 'Drop', 'Drop'),
                        T('WIKI_DROP_COUNT', '%d przedmiot\xf3w', '%d items') % len(tiles)))
        if not tiles:
            entries.append(('text', T('WIKI_NO_DROP', 'Brak w\xb3asnego dropu - tylko wsp\xf3lny drop z poziomu.',
                                      'No drop of its own - only the common drop by level.'), DIM))
        entries += self.TileRows(tiles)
        entries.append(('text', localeInfo.WIKI_COMMON_NOTE, DIM))
        return entries

    def ItemEntries(self, vnum):
        entries = []

        tiles = [('mob', mob, n, p) for mob, n, p in ITEM_MOBS.get(vnum, ())[:40]]
        tiles += [('item', box, n, p) for box, n, p in ITEM_CHESTS.get(vnum, ())[:20]]
        known = set((t[0], t[1]) for t in tiles)
        others = []



        drops = extra.DROP if extra else {}
        chests = extra.CHEST if extra else {}
        for source, owner in catalog.SOURCES.get(vnum, ()):
            if source == 'mob':
                if ('mob', owner) not in known and owner not in drops:
                    tiles.append(('mob', owner, 1, None))
            elif source == 'chest':
                if owner in catalog.ITEMS and ('item', owner) not in known and owner not in chests:
                    tiles.append(('item', owner, 1, None))
            elif source == 'refine' and owner in catalog.ITEMS:
                others.append((getattr(localeInfo, 'WIKI_SOURCE_REFINE') + ': ' + wikiui.ItemName(owner), 'item', owner))
            elif source not in ('mob', 'chest', 'refine'):
                label = getattr(localeInfo, 'WIKI_SOURCE_' + source.upper(), source)
                if (label, '', 0) not in others:
                    others.append((label, '', 0))
        if IsDragonStone(vnum) or vnum in COR_DRACONIS:
            others.append((T('WIKI_ALCHEMY_NOTE', 'Alchemik i okno Smoczych Kamieni (szlifowanie, ulepszanie)',
                             'The Alchemist and the Dragon Stone window (refining, upgrading)'), '', 0))
        entries.append(('head', T('WIKI_ORIGIN_TITLE', 'Sk\xb9d zdoby\xe6', 'Where to get it'), ''))
        for text, linkKind, linkVnum in others:
            entries.append(('link', text, linkKind, linkVnum))
        entries += self.TileRows(tiles)
        if not tiles and not others:
            entries.append(('text', '-', DIM))
        if IsDragonStone(vnum):
            entries += DragonStoneRows(vnum)

        contents = None
        if extra and vnum in extra.CHEST:
            allIn, rows = extra.CHEST[vnum]
            contents = [('item', v, n, p) for v, n, p in rows]
            note = T('WIKI_CHEST_ALL', 'wszystko naraz', 'all at once') if allIn else T('WIKI_CHEST_ONE', 'losowo jeden', 'one at random')
        elif catalog.CHEST_DROP.get(vnum):
            contents = [('item', v, n, None) for v, n in catalog.CHEST_DROP[vnum]]
            note = ''
        if contents:
            entries.append(('head', T('WIKI_CONTENTS', 'Zawarto\x9c\xe6', 'Contents'), note))
            entries += self.TileRows(contents)

        item.SelectItemWiki(vnum)
        refined, refineSet = item.GetRefinedVnum(), item.GetRefineSet()
        if refined and refined in catalog.ITEMS:
            import wiki
            recipe = wiki.GetRefineItems(refineSet)
            cost = ''
            mats = []
            if isinstance(recipe, tuple) and len(recipe) == 14:
                cost = localeInfo.WIKI_REFINE_COST % (recipe[11], recipe[12])
                mats = [('item', recipe[i], recipe[i + 1], None) for i in range(1, 11, 2) if recipe[i] and recipe[i + 1]]
            entries.append(('head', localeInfo.WIKI_UPGRADE_COSTS, cost))
            entries.append(('link', '> ' + wikiui.ItemName(refined), 'item', refined))
            entries += self.TileRows(mats)
        entries.append(('text', localeInfo.WIKI_SNAPSHOT_NOTE, DIM))
        return entries

    def TileRows(self, tiles):
        tiles = [t for t in tiles if not (t[1] > 0 and IsNoName(wikiui.MobName(t[1]) if t[0] == 'mob' else wikiui.ItemName(t[1])))]
        rows = []
        for index in range(0, len(tiles), 2):
            rows.append(('tiles', tiles[index:index + 2]))
        return rows

    def EntryHeight(self, entry):
        return {'head': 26, 'tiles': TILE_H + 4, 'text': 20, 'link': 20}[entry[0]]

    def DrawDetails(self):
        self.pendingDetails = False
        self.drawnDetailsOffset = self.detailOffset
        self.Clear(self.detailWidgets)
        if not self.selected or self.tableMode or not self.headWidgets or not self.detailEntries:
            return
        c = self.detailWidgets
        left = self.detailX + 14
        inner = self.detailW - 40
        avail = self.bottom - 6 - self.detailTop

        total = len(self.detailEntries)
        fit = 0
        used = 0
        for entry in self.detailEntries[self.detailOffset:]:
            h = self.EntryHeight(entry)
            if used + h > avail:
                break
            used += h
            fit += 1
        self.detailPageSize = max(1, fit)
        self.ResizeScrollThumb(self.detailScroll, min(0.9, float(self.detailPageSize) / max(1, total)))
        if self.detailOffset > 0 or self.detailOffset + fit < total:
            self.detailScroll.Show()
        else:
            self.detailScroll.Hide()
        y = self.detailTop
        tileW = (inner - 8) // 2
        for entry in self.detailEntries[self.detailOffset:self.detailOffset + fit]:
            kind = entry[0]
            if kind == 'head':
                self.Text(left, y + 6, entry[1], c, GOLD_SOFT)
                if entry[2]:
                    note = self.Text(left + inner, y + 7, entry[2], c, DIM)
                    note.SetHorizontalAlignRight()
            elif kind == 'text':
                self.Text(left, y + 3, self.Fit(entry[1], inner), c, entry[2])
            elif kind == 'link':
                label = self.Text(left, y + 3, self.Fit(entry[1], inner), c, LINK if entry[2] else TEXT, pick=bool(entry[2]))
                if entry[2]:

                    label.SetSize(inner, 18)
                    label.SetEvent('MOUSE_LEFT_BUTTON_UP', ui.__mem_func__(self.SelectRecord), entry[2], entry[3])
            else:
                for column, tile in enumerate(entry[1]):
                    self.DrawTile(left + column * (tileW + 8), y, tileW, tile)
            y += self.EntryHeight(entry)

    def DrawTile(self, x, y, w, tile):
        kind, vnum, count, pct = tile
        c = self.detailWidgets
        sure = pct is not None and pct >= 100
        known = kind == 'item' and KnownItem(vnum) or kind == 'mob' and vnum in catalog.MOBS
        box = self.Click(x, y, w, TILE_H, TILE, 0xb0221c14, self.SelectRecord if known else None, (kind, vnum) if known else (),
                         c, edge=TILE_TOP if sure else TILE_EDGE)
        if kind == 'item' and vnum > 0:
            box.SetOver(self.ShowTooltip, (vnum,))
            box.SetOut(self.HideTooltip)
        self.Image(x + 3, y + 3, IMG + 'slot/empty_slot.tga', c, w=34, h=34)
        if kind == 'mob':
            mobKind, rank, level = catalog.MOBS.get(vnum, (0, 0, 0))
            self.Image(x + 7, y + 6, MobPicture(vnum, mobKind, rank), c, w=26, h=28)
            name = wikiui.MobName(vnum)
        elif vnum == -1:
            name = 'Yang'
        elif vnum == -2:
            name = T('WIKI_EXP', 'Do\x9cwiadczenie', 'Experience')
        else:
            self.Icon(vnum, x + 4, y + 4, 32, c)
            name = wikiui.ItemName(vnum)
        if count > 1:
            name = '%s x%s' % (name, Money(count) if vnum < 0 else count)
        pctW = 44 if pct is not None else 0
        self.Text(x + 42, y + 6, self.Fit(name, w - 48 - pctW), c, TEXT)
        if pct is not None:
            barW = w - 48 - pctW
            self.Rect(x + 42, y + 26, barW, 3, 0xff1d1912, c)
            fill = int(barW * ChanceFill(pct))
            color = ChanceColor(pct)
            if fill > 0:
                self.Rect(x + 42, y + 26, fill, 3, (color & 0x00ffffff) | 0xd0000000, c)
            label = self.Text(x + w - 5, y + 18, ChanceText(pct), c, color)
            label.SetHorizontalAlignRight()

    def ScrollDetails(self):
        if self.busy:
            return
        total = len(self.detailEntries)
        offset = int(round(self.detailScroll.GetPos() * max(0, total - getattr(self, 'detailPageSize', 1))))
        if offset != self.detailOffset:
            self.detailOffset = offset
            self.pendingDetails = True

    def OnMouseWheel(self, length):
        if not self.IsShow():
            return False
        x, y = wndMgr.GetMousePosition()
        left, top = self.GetGlobalPosition()
        if not (left <= x <= left + self.GetWidth() and top <= y <= top + self.GetHeight()):
            return False
        step = -1 if length > 0 else 1
        if self.tableMode or x < left + self.detailX:
            maximum = max(0, len(self.records) - self.pageSize)
            offset = max(0, min(maximum, self.offset + step * 3))
            if offset != self.offset:
                self.offset = offset
                self.SetScrollPos(self.resultScroll, float(self.offset) / max(1, maximum))
                self.pendingResults = True
        else:
            maximum = max(0, len(self.detailEntries) - getattr(self, 'detailPageSize', 1))
            offset = max(0, min(maximum, self.detailOffset + step))
            if offset != self.detailOffset:
                self.detailOffset = offset
                self.SetScrollPos(self.detailScroll, float(self.detailOffset) / max(1, maximum))
                self.pendingDetails = True
        return True

    def OnUpdate(self):
        if not self.IsShow():
            return
        if self.pendingResults and self.offset == self.drawnResultsOffset:
            self.pendingResults = False
        if self.pendingDetails and self.detailOffset == self.drawnDetailsOffset:
            self.pendingDetails = False
        now = clientclock.Now()
        if now >= self.nextScrollDraw and (self.pendingResults or self.pendingDetails):
            self.HideTooltip()
            if self.pendingResults:
                self.DrawResults()
            if self.pendingDetails:
                self.DrawDetails()
            self.nextScrollDraw = clientclock.Now() + SCROLL_DRAW_INTERVAL
        if self.query.IsFocus() or self.query.GetText():
            self.queryHint.Hide()
        else:
            self.queryHint.Show()


    def ChangeSize(self, step):
        index = max(0, min(len(SIZES) - 1, self.sizeIndex + step))
        if index == self.sizeIndex:
            return
        query, selected = self.query.GetText(), self.selected
        self.sizeIndex = index
        self.HideTooltip()
        for collection in (self.resultWidgets, self.detailWidgets, self.headWidgets, self.chips, self.widgets):
            self.Clear(collection)
        self.Build()
        self.query.SetText(query)
        self.Search()
        if selected:
            self.SelectRecord(selected[0], selected[1], False)

    def Back(self):
        if self.history:
            kind, vnum = self.history.pop()
            self.SelectRecord(kind, vnum, False)

    def ShowTooltip(self, vnum):
        if self.tooltip and vnum > 0 and item.SelectItemWiki(vnum):
            self.tooltip.SetItemToolTip(vnum)

    def HideTooltip(self):
        if self.tooltip:
            self.tooltip.HideToolTip()

    def BindTooltip(self, tooltip):
        from _weakref import proxy
        self.tooltip = proxy(tooltip)

    def LoadGuidePage(self):
        self.SelectCategory(0)

    def ShowItemInfo(self, vnum, argument=0):
        self.SelectRecord('item' if argument == 0 else 'mob', vnum)

    def Open(self):
        if self.selected and not self.tableMode:
            self.DrawHead()
            self.DrawDetails()
        self.Show()
        self.SetTop()

    def Close(self):
        for widget in self.headWidgets:
            if isinstance(widget, WikiModelPreview):
                widget.Release()
        self.HideTooltip()
        self.Hide()

    def OnPressEscapeKey(self):
        self.Close()
        return True

    def OnPressExitKey(self):
        return self.OnPressEscapeKey()

    def Destroy(self):
        self.Close()
        for collection in (self.resultWidgets, self.detailWidgets, self.headWidgets, self.chips, self.widgets):
            self.Clear(collection)
        self.tooltip = None
        self.records, self.detailEntries, self.history = [], [], []
        self.selected = None
        self.sideRows = []
        self.query = self.resultScroll = self.detailScroll = None
        self.measure = None
        self.fitCache = {}
        self.equipmentRecords = None
        self.equipmentColumns = []
        ui.BoardWithTitleBar.Destroy(self)

    def __del__(self):
        ui.BoardWithTitleBar.__del__(self)
# The wiki's page of an item or a monster, on Ctrl+Alt and the right button
# (Tyrion, 30 September): an item in the bag (uiinventory.py) and the monster,
# stone or NPC on the target board (uitarget.py). The browser is opened by
# utils.open_url, as the game options' Discord button opens it; an empty
# WIKI_URL switches it off.
import utils

WIKI_URL = "https://metin2singleplayer.com/wiki/"


def _open(path):
	if not WIKI_URL:
		return
	utils.open_url(WIKI_URL.rstrip("/") + "/#/" + path)


def OpenItem(vnum):
	if vnum > 0:
		_open("przedmiot/%d" % vnum)


def OpenMob(vnum):
	if vnum > 0:
		_open("potwor/%d" % vnum)


def IsWikiClick():
	import app
	return app.IsPressed(app.DIK_LCONTROL) and app.IsPressed(app.DIK_LALT)
import ui
import localeInfo
import uiCommon
import uiScriptLocale
import app
import net
from _weakref import proxy

class WonExchangeWindow(ui.ScriptWindow):
	WON_NAME_VALUE = 100000000
	TAX_NAME_MUL = 0
	PAGE_BUY, PAGE_SELL = range(2)

	def __init__(self):
		ui.ScriptWindow.__init__(self)
		self.page = self.PAGE_BUY
		self.isLoaded = 0

		self.__Initialize()
		self.__LoadWindow()

	def __del__(self):
		ui.ScriptWindow.__del__(self)

	def Destroy(self):
		self.ClearDictionary()
		self.__Initialize()

	def __Initialize(self):
		self.interface = None
		self.tabDict = None
		self.tabButtonDict = None
		self.pageDict = None
		self.titleBarDict = None
		self.inputWon = None
		self.resultGold = None
		self.dlgQuestion = None

	def __LoadWindow(self):
		if self.isLoaded == 1:
			return

		self.isLoaded = 1

		try:
			pyScrLoader = ui.PythonScriptLoader()
			pyScrLoader.LoadScriptFile(self, "UIScript/WonExchangeWindow.py")
		except:
			import exception
			exception.Abort("WonExchangeWindow.__LoadWindow.LoadScriptFile.UIScript/WonExchangeWindow.py")

		try:
			self.__BindObject()
		except:
			import exception
			exception.Abort("WonExchangeWindow.__LoadWindow.__BindObject.UIScript/WonExchangeWindow.py")

		try:
			self.__BindEvent()
		except:
			import exception
			exception.Abort("WonExchangeWindow.__LoadWindow.__BindEvent.UIScript/WonExchangeWindow.py")

		self.SetPage(self.PAGE_SELL)

	def __BindObject(self):
		self.tabDict = {
			self.PAGE_SELL	: self.GetChild("Tab_01"),
			self.PAGE_BUY	: self.GetChild("Tab_02"),
		}

		self.tabButtonDict = {
			self.PAGE_SELL	: self.GetChild("Tab_Button_01"),
			self.PAGE_BUY	: self.GetChild("Tab_Button_02"),
		}

		self.pageDict = {
			self.PAGE_BUY	: self.GetChild("CurrencyConverter_Page"),
			self.PAGE_SELL	: self.GetChild("CurrencyConverter_Page"),
		}

		self.titleBarDict = {
			self.PAGE_BUY	: self.GetChild("BuyWon_TitleBar"),
			self.PAGE_SELL	: self.GetChild("SellWon_TitleBar"),
		}

		self.inputWon = self.GetChild("Input")
		self.inputWon.SetEscapeEvent(ui.__mem_func__(self.Close))
		self.resultGold = self.GetChild("Result")
		self.acceptButton = self.GetChild("AcceptButton")

		if localeInfo.IsARABIC():
			for tab in self.tabDict.itervalues():
				tab.SetScale(-1.0, 1.0)
				tab.SetRenderingRect(-1.0, 0.0, 1.0, 0.0)

		self.dlgQuestion = uiCommon.QuestionDialog2()
		self.dlgQuestion.Close()

	def __BindEvent(self):
		for (tabKey, tabButton) in self.tabButtonDict.items():
			tabButton.SetEvent(ui.__mem_func__(self.__OnClickTabButton), tabKey)

		for titleBarValue in self.titleBarDict.itervalues():
			titleBarValue.SetCloseEvent(ui.__mem_func__(self.Close))

		self.inputWon.OnIMEUpdate = ui.__mem_func__(self.__CustomeIMEUpdate)
		self.acceptButton.SetEvent(ui.__mem_func__(self.__OpenQuestionDialog))

	def __CustomeIMEUpdate(self):
		ui.EditLine.OnIMEUpdate(self.inputWon)
		try:
			self.resultGold.SetText("%s" % (localeInfo.MoneyFormat(long(((1.0 + self.TAX_NAME_MUL / 100.0) if self.page == self.PAGE_BUY else 1.0) * self.WON_NAME_VALUE) * long(self.inputWon.GetText()))))
		except:
			self.resultGold.SetText("")

	def ClearCurrencyConverterPage(self, isFocus):
		self.inputWon.SetText("")
		self.resultGold.SetText("")
		if isFocus:
			self.inputWon.SetFocus()
		else:
			self.inputWon.KillFocus()

	def __OnClickTabButton(self, pageKey):
		self.dlgQuestion.Close()
		self.ClearCurrencyConverterPage(True)
		self.SetPage(pageKey)

	def Open(self):
		self.__OnClickTabButton(self.PAGE_SELL)
		self.Show()

	def SetPage(self, pageKey):
		self.page = pageKey

		for (tabKey, tabButton) in self.tabButtonDict.items():
			if pageKey!=tabKey:
				tabButton.SetUp()

		for tabValue in self.tabDict.itervalues():
			tabValue.Hide()

		for pageValue in self.pageDict.itervalues():
			pageValue.Hide()

		for titleBarValue in self.titleBarDict.itervalues():
			titleBarValue.Hide()

		self.titleBarDict[pageKey].Show()
		self.tabDict[pageKey].Show()
		self.pageDict[pageKey].Show()

	def __OpenQuestionDialog(self):
		if not self.inputWon.GetText():
			return

		self.dlgQuestion.SetAcceptEvent(ui.__mem_func__(self.__Accept))
		self.dlgQuestion.SetCancelEvent(ui.__mem_func__(self.__Cancel))

		args = (int(self.inputWon.GetText()), localeInfo.MoneyFormat(long(((1.0 + self.TAX_NAME_MUL / 100.0) if self.page == self.PAGE_BUY else 1.0) * self.WON_NAME_VALUE) * long(self.inputWon.GetText())))
		if self.page == self.PAGE_SELL:
			self.dlgQuestion.SetText1(localeInfo.WONEXCHANGE_CONFIRM_QUESTION_1 % args)
		elif self.page == self.PAGE_BUY:
			self.dlgQuestion.SetText1(localeInfo.WONEXCHANGE_CONFIRM_QUESTION_2 % args)
		self.dlgQuestion.SetText2(localeInfo.WONEXCHANGE_CONFIRM_QUESTION_3)
		self.dlgQuestion.Open()

	def __Accept(self):
		if not self.inputWon.GetText():
			return

		self.dlgQuestion.Close()

		if self.page == self.PAGE_SELL:
			net.SendChatPacket("/won_exchange sell {}".format(self.inputWon.GetText()))
		elif self.page == self.PAGE_BUY:
			net.SendChatPacket("/won_exchange buy {}".format(self.inputWon.GetText()))

		self.ClearCurrencyConverterPage(True)

	def __Cancel(self):
		self.dlgQuestion.Close()

	def BindInterface(self, interface):
		self.interface = proxy(interface)

	def Close(self):
		if self.dlgQuestion.IsShow():
			self.dlgQuestion.Close()

		for tries in xrange(3): 
			if self.inputWon:
				self.inputWon.KillFocus()
			self.KillFocus()
		self.Hide()

	def ExternQuestionDialog_Close(self):
		if self.dlgQuestion.IsShow():
			self.dlgQuestion.Close()

	def IsDlgQuestionShow(self):
		return self.dlgQuestion and self.dlgQuestion.IsShow()

	def OnPressEscapeKey(self):
		self.Close()
		return True
import ui
import app
import player
import eventManager
import time
import localeInfo
import updateable

from ui_event import Event

class WorldBossData:
    def __init__(self, vnum):
        self.vnum = vnum
        self.alive = False
        self.respawn_time = 0
        self.ranking = []
        self.personal = None

    def update_day_info(self, alive, respawn_time):
        self.alive = alive
        self.respawn_time = respawn_time

    def add_ranking_entry(self, rank, name, damage, timestamp):
        self.ranking.append({
            "rank": rank,
            "name": name,
            "damage": damage,
            "timestamp": timestamp
        })

    def set_personal_entry(self, name, damage, timestamp):
        self.personal = {
            "name": name,
            "damage": damage,
            "timestamp": timestamp
        }

    def clear_ranking(self):
        del self.ranking[:]

        self.personal = None

class WorldBossController(ui.SimplyWindow):
    def __init__(self, *args, **kwargs):
        super(WorldBossController, self).__init__(
            "UI", ("movable", "float"),
            645, 375,
            self.__Initialize, self.__Destroy
        )

    def __Initialize(self):
        self.windowConfig["user-defines"] = {
            "data" : {}
        }
        self.SetSize(*self.windowConfig["size"].values())

        board = self.__CreateBoard()
        self.tab = self.__CreateTabs(board)
        self.renderTarget = self.__CreateRenderTarget(board)

        right_panel_x = self.renderTarget.GetLocalPosition()[0] + self.renderTarget.GetWidth() - 1
        self.headers, self.dungeonImage = self.__CreateHeaders(right_panel_x, board)
        self.__CreateInfoBoxes(right_panel_x, board, self.headers[2], self.dungeonImage)

        self.AppendObject("data", (self.renderTarget, self.headers, self.dungeonImage))

        eventManager.EventManager().add_observer("WORLD_BOSS_REGISTER_DAY", self.__RegisterDay)
        eventManager.EventManager().add_observer("WORLD_BOSS_REGISTER_RANKING", self.__RegisterRanking)
        eventManager.EventManager().add_observer("WORLD_BOSS_REGISTER_PERSONAL", self.__RegisterPersonal)

    def __Destroy(self):
        pass

    def Open(self):
        super(WorldBossController, self).Open()
        self.__Refresh()

    def Close(self):
        super(WorldBossController, self).Close()

    def OnKeyDown(self, key):
        if key == app.VK_ESCAPE:
            self.Close()
            return True
        return False

    def __CreateBoard(self):
        board = ui.BoardWithTitleBar()
        board.SetParent(self)
        board.SetPosition(0, 0)
        board.SetSize(*self.GetSize())
        board.SetTitleName("World Boss")
        board.SetCloseEvent(Event(self.Close))
        board.Show()
        self.AppendObject("board", board)
        return board

    def __CreateTabs(self, parent):
        tab = ui.TabBoard()
        tab.SetParent(parent)
        tab.SetPosition(10, 30)
        tab.SetSize(parent.GetWidth(), 33)
        tab.SetTabWidth(89)
        tab.SetVisual(
            "Assets/ui/world-boss/button-tab-0.png",
            "Assets/ui/world-boss/button-tab-1.png",
            "Assets/ui/world-boss/button-tab-1.png"
        )
        tab.Show()

        self.day_names = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
        for i, day in enumerate(self.day_names):
            tab.AppendTab(day)
            tab.SetTabEvent(day, Event(self.__RequestData, i))

        self.AppendObject("tab", tab)
        return tab

    def __CreateRenderTarget(self, parent):
        tab = self.GetObject("tab")
        renderTarget = ui.RenderTarget()
        renderTarget.SetParent(parent)
        renderTarget.SetPosition(tab.GetLocalPosition()[0], tab.GetLocalPosition()[1] + tab.GetHeight() + 2)
        renderTarget.SetSize(298, 299)
        renderTarget.SetRenderTarget(5)
        renderTarget.Show()
        return renderTarget

    def __CreateHeaders(self, x, parent):
        headers = [ui.TransparentButton() for _ in range(3)]

        headers[0].SetParent(parent)
        headers[0].SetPosition(x, self.tab.GetLocalPosition()[1] + self.tab.GetHeight())
        headers[0].SetUpVisual("Assets/ui/world-boss/header-up.png")
        headers[0].Show()
        headers[0].SetText("Boss Info")

        image = ui.ImageBox()
        image.SetParent(parent)
        image.SetPosition(x, headers[0].GetLocalPosition()[1] + headers[0].GetHeight() + 3)
        image.LoadImage("Assets/ui/world-boss/dungeon-image.png")
        image.Show()

        headers[1].SetParent(parent)
        headers[1].SetPosition(x, image.GetLocalPosition()[1] + image.GetHeight() + 3)
        headers[1].SetUpVisual("Assets/ui/world-boss/header-status.png")
        headers[1].Show()
        headers[1].SetText("Status")

        headers[2].SetParent(parent)
        headers[2].SetPosition(x + headers[1].GetWidth(), headers[1].GetLocalPosition()[1])
        headers[2].SetUpVisual("Assets/ui/world-boss/header-ranking.png")
        headers[2].Show()
        headers[2].SetText("Ranking")

        return headers, image

    def __CreateInfoBoxes(self, x, parent, header_ranking, image):
        y_pos = header_ranking.GetLocalPosition()[1] + header_ranking.GetHeight()

        box_status = ui.MakeImageBox(parent, "Assets/ui/world-boss/background-status.png", x, y_pos)
        self.AppendObject("boxes", box_status, True)

        self.status_images = []
        self.status_texts = []

        for i in range(2):
            img = ui.ImageBox()
            img.SetParent(box_status)
            img.LoadImage("Assets/ui/world-boss/input-status.png")
            img.SetPosition(0, 10 + i * 35)
            img.SetWindowHorizontalAlignCenter()
            img.Show()
            self.status_images.append(img)

        labels = ["Status: ", "", "Time: ", ""]
        for i in range(4):
            line = ui.TextLine()
            line.SetParent(self.status_images[i // 2])
            line.SetPosition(5 if i % 2 == 0 else 0, 0)
            line.SetText(labels[i])
            if i % 2 == 1:
                line.SetWindowHorizontalAlignRight()
                line.SetHorizontalAlignRight()
            line.SetWindowVerticalAlignCenter()
            line.SetVerticalAlignCenter()
            line.Show()
            self.status_texts.append(line)

        self.AppendObject("status-data", (self.status_images, self.status_texts))

        teleport_btn = ui.Button()
        teleport_btn.SetParent(box_status)
        teleport_btn.SetPosition(0, 38)
        teleport_btn.SetUpVisual("Assets/ui/world-boss/button-teleport-0.png")
        teleport_btn.SetOverVisual("Assets/ui/world-boss/button-teleport-0.png")
        teleport_btn.SetDownVisual("Assets/ui/world-boss/button-teleport-0.png")
        teleport_btn.SetText("Teleport")
        teleport_btn.SetWindowHorizontalAlignCenter()
        teleport_btn.SetWindowVerticalAlignBottom()
        teleport_btn.Show()
        self.AppendObject("teleport-button", teleport_btn)

        x_pos_next = x + box_status.GetWidth()
        box_ranking = ui.MakeImageBox(parent, "Assets/ui/world-boss/background-ranking.png", x_pos_next, y_pos)
        self.AppendObject("boxes", box_ranking)

        rank_img = ui.ImageBox()
        rank_img.SetParent(box_ranking)
        rank_img.SetPosition(0, 10)
        rank_img.LoadImage("Assets/ui/world-boss/ranking-rows.png")
        rank_img.SetWindowHorizontalAlignCenter()
        rank_img.Show()
        self.AppendObject("ranking-image", rank_img)

        self.ranking_lines = []

        for i in range(5):
            line = ui.TextLine()
            line.SetParent(rank_img)
            line.SetPosition(45, 2 + i * 20)
            line.SetText("")
            line.Show()
            self.ranking_lines.append(line)

        self.AppendObject("ranking-lines", self.ranking_lines)

    def __RequestData(self, day_index):
        self.__UpdateDungeonImage(day_index)
        if day_index not in self.windowConfig["user-defines"]["data"]:
            return

        entries = list(self.windowConfig["user-defines"]["data"][day_index].values())
        if not entries:
            return

        self.__DisplayEntry(entries[0])

    def __Refresh(self):
        player.SetBackground(5, "Assets/ui/world-boss/background-render.png")
        player.SetVisibility(5, True)
        self.__RequestData(0)

    def __UpdateStatusInfo(self, status_text, time_text):
        self.status_texts[1].SetText(status_text)
        self.status_texts[3].SetText(time_text)

    def __UpdateDungeonImage(self, index):
        
        dungeon_images = [
            "Assets/ui/world-boss/dungeon-image.png",
            "Assets/ui/world-boss/dungeon-image.png",
            "Assets/ui/world-boss/dungeon-image.png",
            "Assets/ui/world-boss/dungeon-image.png",
            "Assets/ui/world-boss/dungeon-image.png",
            "Assets/ui/world-boss/dungeon-image.png",
            "Assets/ui/world-boss/dungeon-image.png",
        ]
        self.dungeonImage.LoadImage(dungeon_images[index % len(dungeon_images)])

    def __ConvertDayIndexFromServer(self, server_day_index):
        return (server_day_index - 1) % 7

    def __RegisterDay(self, server_day_index, vnum, is_alive, next_spawn_time):
        sys_err("A", [server_day_index, vnum, is_alive, next_spawn_time])
        day_index = self.__ConvertDayIndexFromServer(server_day_index)
        if day_index not in self.windowConfig["user-defines"]["data"]:
            self.windowConfig["user-defines"]["data"][day_index] = {}

        if vnum not in self.windowConfig["user-defines"]["data"][day_index]:
            self.windowConfig["user-defines"]["data"][day_index][vnum] = WorldBossData(vnum)

        boss = self.windowConfig["user-defines"]["data"][day_index][vnum]
        boss.update_day_info(is_alive, next_spawn_time)
        boss.clear_ranking()

        if self.tab.GetSelectedTabIndex() == day_index:
            self.__RequestData(day_index)

    def __RegisterRanking(self, server_day_index, vnum, rank, name, damage, timestamp):
        day_index = self.__ConvertDayIndexFromServer(server_day_index)
        if day_index in self.windowConfig["user-defines"]["data"] and vnum in self.windowConfig["user-defines"]["data"][day_index]:
            self.windowConfig["user-defines"]["data"][day_index][vnum].add_ranking_entry(rank, name, damage, timestamp)

    def __RegisterPersonal(self, server_day_index, vnum, name, damage, timestamp):
        day_index = self.__ConvertDayIndexFromServer(server_day_index)
        if day_index in self.windowConfig["user-defines"]["data"] and vnum in self.windowConfig["user-defines"]["data"][day_index]:
            self.windowConfig["user-defines"]["data"][day_index][vnum].set_personal_entry(name, damage, timestamp)

    def __DisplayEntry(self, boss):
        self.current_boss = boss

        if boss.alive:
            alive_text = "Alive"
            time_text = "Now"
        else:
            alive_text = "Dead"
            self.respawn_seconds_remaining = app.GetTime() + boss.respawn_time
            time_text = localeInfo.sec2time(self.respawn_seconds_remaining, "DHMS")

        self.__UpdateStatusInfo(alive_text, time_text)
        player.SelectModel(5, boss.vnum)
        self.__UpdateRanking(boss)            

    def OnUpdate(self):
        if self.respawn_seconds_remaining - app.GetTime() > 0:
            self.status_texts[3].SetText(localeInfo.sec2time(self.respawn_seconds_remaining - app.GetTime(), "DHMS"))
        else:
            self.status_texts[1].SetText("Alive")
            self.status_texts[3].SetText("Now")

    def __UpdateRanking(self, boss):
        print("--- Ranking ---")
        sys_err(boss.ranking)
        ranking_lines = self.GetObject("ranking-lines")
        for line, entry in zip(ranking_lines, boss.ranking):
            line.SetText("{} - {}".format(entry['name'], entry['damage']))

        
        for line in ranking_lines[len(boss.ranking):]:
            line.SetText("")

    def __FormatRespawnTime(self, timestamp):
        """
        Zwraca sformatowany czas z timestampu.
        """
        return time.strftime("%H:%M:%S", time.localtime(timestamp))import app
import player
import ime

FIXED_TIMESTEP_UPDATE = 167
ONE_SECOND = 10000


class UpdatableAbstract:
	def __init__(self):
		pass

	def OnUpdate(self):
		pass

	def Destroy(self):
		pass

	def CanUpdate(self):
		return False


class PickUpOnDownKey(UpdatableAbstract):
	def __init__(self):
		UpdatableAbstract.__init__(self)
		self.timer = 0
		self.delay = 1500  # 0.15s

	def OnUpdate(self):
		self.timer += FIXED_TIMESTEP_UPDATE
		if self.timer >= self.delay:
			import pickupnearby
			if pickupnearby.FilterMask() is None:
				player.PickCloseItem()
			elif app.IsPressed(app.DIK_GRAVE):
				pickupnearby.Request()
			else:
				pickupnearby.PickOne()
			self.timer = 0

	def CanUpdate(self):
		return not ime.IsCaptureInput() and (app.IsPressed(app.DIK_Z) or app.IsPressed(app.DIK_GRAVE))
import constInfo

class Sandbox(object):
	# DO NOT REMOVE ANY ENTRY OF WHITE LIST
	# THIS ENTIES ARE USED FOR Sandbox.
	# 	(If sys.modules['__main__'] is changed, you can see the hell.)
	WHITE_LIST = ['__builtin__', 'types', __name__, '__main__', 'sys']
	def __init__(self, prevent_imported_modules = False, allowed_modules = [], prevented_modules = [], allowed_paths = []):
		self.prevent_imported_modules = prevent_imported_modules
		self.allowed_modules = allowed_modules
		self.prevented_modules = prevented_modules
		self.allowed_paths = allowed_paths

	def add_allowed_modules(self, allowed_modules):
		self.allowed_modules = self.allowed_modules + allowed_modules

	def add_prevented_modules(self, prevented_modules):
		self.prevented_modules = self.prevented_modules + prevented_modules

	def execfile(self, filename, dic):
		import sys
		import copy

		for allowed_module_name in self.allowed_modules:
			try:
				exec 'import {0}'.format(allowed_module_name)
			except:
				# Just now, pass the exception.
				# (filename could not use this module)
				sys.modules['dbg'].TraceError("UISCRIPT_LOAD_ERROR: Could not import %s [filename %s]" % (allowed_module_name, filename)) # @fixme004 (sys.stderr.write to dbg.TraceError)
				pass
		# shallow copy of sys.modules
		old_modules = copy.copy(sys.modules)

		old_path = sys.path
		sys.path = self.allowed_paths

		# set current imported modules None
		if self.prevent_imported_modules:
			import types
			for k, v in old_modules.items():
				if type(v) == types.ModuleType:
					if not (k in self.WHITE_LIST or k in self.allowed_modules):
						sys.modules[k] = None

		# set prevented modules None.
		for prevented_module_name in self.prevented_modules:
			sys.modules[prevented_module_name] = None

		try:
			f = open(filename, 'rb')
			data = f.read()
			code = compile(data, filename, 'exec')
			exec code in dic
		except Exception as e:
			old_modules['dbg'].TraceError("UISCRIPT_LOAD_ERROR: %s [filename %s]" % (str(e), filename)) # @fixme004 (sys.stderr.write to dbg.TraceError)
		finally:
			# Restore original settings.
			#sys.modules = old_modules# <- This is not effective. I don't know why, but I guess some where got old sys.modules reference and access old one.
			for k, v in sys.modules.items():
				if not k in old_modules:
					del sys.modules[k]
			for k, v in old_modules.items():
				sys.modules[k] = v

			sys.path = old_path

#######################################################
#	@usage:
#		GetElementDictByName(window,"BoardExample")
#
#	@desc:
#		it could search in a dict (script file for ScriptWindow) an element (whether it is child of window or another child in the tree)
#
#	@notes:
#		adviced to check the return before to access (it could be None)
def GetElementDictByName(dct, name):
	if 'children' in dct:
		for child in dct['children']:
			if 'name' in child:
				if child['name'] == name:
					return child

			if 'children' in child:
				search = GetElementDictByName(child, name)
				if search != None:
					return search
	return None

### Find the element <name> inside <parent> and return the pos
def FindElementPos(parent, name):
	for i in range(len(parent)):
		if parent[i]["name"] == name:
			return i
	return -1

### Find the element <name> inside <parent> and return the ref
def FindElementRef(parent, name):
	for i in range(len(parent)):
		if parent[i]["name"] == name:
			return parent[i]
	return None

### Find the element <name> inside <parent> and add it before that (only for lists)
def ElementAddBefore(parent, name, obj):
	i = FindElementPos(parent, name)
	if i != -1:
		parent.insert(i, obj)

### Find the element <name> inside <parent> and add it after that (only for lists)
def ElementAddAfter(parent, name, obj):
	i = FindElementPos(parent, name)
	if i != -1:
		parent.insert(i+1, obj)

def FindElement(name, data):
	if 'children' in data:
		for child in data['children']:
			if child.get('name', '') == name:
				return child
		for child in data['children']:
			res = FindElement(name, child)
			if res:
				return res
	return None

def ReplaceElement(name, nvalue, data):
	value = FindElement(name, data)
	for n, v in nvalue.items():
		value[n] = v
	for n in value:
		if n not in nvalue:
			del value[n]

def AppendChildren(name, children, data):
	value = FindElement(name, data)
	value['children'] = value.get('children', tuple()) + children

import player
def CountItemCountInInventory(item_vnum):
	total_count = 0

	# Every bag page, and the horse page while the horse is out.
	slotCount = player.INVENTORY_DEFAULT_MAX_NUM
	if constInfo.IS_HORSE_SUMMONED:
		slotCount = player.INVENTORY_MAX_NUM

	for i in xrange(slotCount):
		if player.GetItemIndex(i) == item_vnum:
			total_count += player.GetItemCount(i)

	return total_count

import difflib
def check_string_similarity(input, check_word, threshold=0.6):
	similarity = difflib.SequenceMatcher(None, input, check_word).ratio()
	if len(input) <= len(check_word) and check_word.startswith(input) and similarity >= threshold:
		return True
	return False

import os
def open_url(url):
	os.popen("start %s" % (url))

import item
import nonplayer
def process_string(input_string, token):
	start_index = input_string.find('{%s' % token)
	end_index = input_string.find('}')

	value = None
	transformed_value = None

	if start_index != -1 and end_index != -1:
		value_start = start_index + 2
		value = int(input_string[value_start:end_index])

		if token == "i":
			item.SelectItem(value)
			transformed_value = item.GetItemName()
		elif token == "m":
			transformed_value = nonplayer.GetMonsterName(value)

		input_string = input_string[:start_index] + transformed_value + input_string[end_index + 1:]

	transformed_string = input_string.strip()

	return transformed_string, value

import ui
class ToggleButton(ui.Window):
	def __init__(self):
		super(ToggleButton, self).__init__()
		
		self.__Initialize()
		self.__BuildPage()
	
	def __del__(self):
		self.__Destroy()
		super(ToggleButton, self).__del__()
	
		#Private Methods
	def __Initialize(self):
		self.loadedWindow = False
		
		self.base_board = None
		self.button_scale = 1.0

		self.invStagesWindow = None
		self.txtLine = None
		
		self.clickEvent = None
		self.buttonState = 0
		self.button_images = []
	
	def __Destroy(self):
		if self.base_board:
			self.base_board.Hide()
			self.base_board.Destroy()
		
		del self.base_board
		self.base_board = None

		if self.invStagesWindow:
			self.invStagesWindow.Hide()
			self.invStagesWindow.Destroy()
		
		del self.invStagesWindow
		self.invStagesWindow = None

		if self.txtLine:
			self.txtLine.Hide()
			self.txtLine.Destroy()
		
		del self.txtLine
		self.txtLine = None

	def __BuildPage(self):
		if self.loadedWindow is True:
			return
		
		self.base_board = ui.ExpandedImageBox()
		self.base_board.SetParent(self)
		self.base_board.SetPosition(0, 0)
		self.base_board.Show()
		
		self.invStagesWindow = ui.Window()
		self.invStagesWindow.SetParent(self)
		self.invStagesWindow.SetPosition(0, 0)
		self.invStagesWindow.SAFE_SetStringEvent("MOUSE_OVER_IN", self.OnHover)
		self.invStagesWindow.SAFE_SetStringEvent("MOUSE_OVER_OUT", self.OnUp)
		self.invStagesWindow.SAFE_SetStringEvent("MOUSE_LEFT_BUTTON", self.OnDown)
		self.invStagesWindow.Show()
		
		self.txtLine = ui.TextLine()
		self.txtLine.SetParent(self.base_board)
		self.txtLine.Hide()
		
		self.loadedWindow = True
	
	def __ReloadButtonSize(self):
		self.SetSize(self.base_board.GetWidth(), self.base_board.GetHeight())
		self.invStagesWindow.SetSize(self.base_board.GetWidth(), self.base_board.GetHeight())
	
		#Public Methods
	def SetText(self, txt, centerAlign = True):
		if not self.txtLine:
			return
		
		self.txtLine.SetText(txt)
		if centerAlign:
			self.txtLine.SetPosition(((self.GetWidth() / 2) - (self.txtLine.GetTextSize()[0] / 2)),\
					((self.GetHeight() / 2) - (self.txtLine.GetTextSize()[1] / 2)))
		self.txtLine.Show()
	
	def SetTextPosition(self, x, y):
		if not self.txtLine:
			return
		
		self.txtLine.SetPosition(x, y)
	
	def SetButtonVisual(self, images, scale = 1.0):
		if not isinstance(images, list):
			return
		
		if len(images) != 3:
			return
		
		self.button_images = images
		self.button_scale = max(scale, 0.0)

		self.base_board.LoadImage(self.button_images[self.buttonState])
		self.base_board.SetScale(self.button_scale, self.button_scale)

		self.__ReloadButtonSize()
	
	def SAFE_SetClickEvent(self, event, *args):
		self.clickEvent = (ui.__mem_func__(event), args)
	
	def OnUp(self, forceEvent = False):
		if forceEvent is False:
			if not self.base_board or\
				self.buttonState == 2:
				return
		
		self.buttonState = 0

		self.base_board.LoadImage(self.button_images[self.buttonState])
		self.base_board.SetScale(self.button_scale, self.button_scale)
	
	def OnHover(self):
		if not self.base_board or\
			self.buttonState == 2:
			return
		
		self.buttonState = 1

		self.base_board.LoadImage(self.button_images[self.buttonState])
		self.base_board.SetScale(self.button_scale, self.button_scale)
	
	def OnDown(self, runEvent = True):
		if not self.base_board:
			return
		
		if self.buttonState == 2:
			self.buttonState = 0
		else:
			self.buttonState = 2
		
		self.base_board.LoadImage(self.button_images[self.buttonState])
		self.base_board.SetScale(self.button_scale, self.button_scale)
			
		if runEvent is True:
			if self.clickEvent:
				apply(*self.clickEvent)
	
	def Show(self):
		super(ToggleButton, self).Show()
	
	def Hide(self):
		super(ToggleButton, self).Hide()

class MoreiraButton(ui.Window):
	DEFAULT_BUTTON_STATE,\
	HOVER_BUTTON_STATE,\
	DOWN_BUTTON_STATE,\
	DISABLE_BUTTON_STATE\
	= range(4)
	
	def __init__(self, parent, isRadioButton = False):
		super(MoreiraButton, self).__init__()
		
		if not parent:
			dbg.TraceError('[MoreiraButton] Received a none parent in constructor.')
			return
		
		self.__Initialize(parent, isRadioButton)
		self.__BuildBaseWindow()
		self.__BuildButton()
	
	def __del__(self):
		super(MoreiraButton, self).__del__()
	
		#@ Private Methods
	def __Initialize(self, parent, isRadioButton):
		from _weakref import proxy
		
		self.parent = proxy(parent)
		self.isRadioButton = isRadioButton
		
		self.objButtonBaseNorm = None
		self.objButtonBaseDown = None
		self.objButtonIdentifier = None
		self.objButtonLightEffect = None
		
		self.lastButtonState = self.DEFAULT_BUTTON_STATE
		self.wndAnimationController = None
	
	def __BuildBaseWindow(self):
		self.SetWindowName('MoreiraButton')
		self.SetParent(self.parent)
		self.SetPosition(0, 0)
		self.Hide()
	
	def __BuildButton(self):
		self.objButtonBaseNorm = ui.ExpandedImageBox()
		self.objButtonBaseNorm.SetParent(self)
		self.objButtonBaseNorm.SetPosition(0, 0)
		self.objButtonBaseNorm.Show()
		
		self.objButtonBaseDown = ui.ExpandedImageBox()
		self.objButtonBaseDown.SetParent(self)
		self.objButtonBaseDown.SetPosition(0, 0)
		self.objButtonBaseDown.Show()
		
		self.objButtonIdentifier = ui.ExpandedImageBox()
		self.objButtonIdentifier.SetParent(self)
		self.objButtonIdentifier.SetPosition(0, 0)
		self.objButtonIdentifier.Show()
		
		self.objButtonLightEffect = ui.ExpandedImageBox()
		self.objButtonLightEffect.SetParent(self)
		self.objButtonLightEffect.SetPosition(0, 0)
		self.objButtonLightEffect.Show()
		
		self.wndAnimationController = ui.Window()
		self.wndAnimationController.SetParent(self)
		self.wndAnimationController.SetPosition(0, 0)
		if self.isRadioButton:
			# self.wndAnimationController.SetOverInEvent(ui.__mem_func__(self.__OnRadioHover))
			# self.wndAnimationController.SetOverOutEvent(ui.__mem_func__(self.__OnRadioUp))
			self.wndAnimationController.SetMouseLeftButtonDownEvent(ui.__mem_func__(self.__OnRadioDown))
		else:
			self.wndAnimationController.SAFE_SetStringEvent("MOUSE_OVER_IN", self.__OnHover)
			self.wndAnimationController.SAFE_SetStringEvent("MOUSE_OVER_OUT", self.__OnUp)
			self.wndAnimationController.SAFE_SetStringEvent("MOUSE_LEFT_BUTTON", self.__OnDown)
			self.wndAnimationController.SAFE_SetStringEvent("MOUSE_LEFT_BUTTON_UP", self.__OnUpAfterDown)
		self.wndAnimationController.Show()
		
		self.__ReloadButtonSize([0, 0])
	
	def __ReloadButtonSize(self, size):
		self.SetSize(*size)
		if self.wndAnimationController:
			self.wndAnimationController.SetSize(*size)
	
	def __SwitchButtonBaseState(self, newState):
		if (not self.objButtonBaseNorm) or (not self.objButtonBaseDown) or\
			(not self.objButtonIdentifier) or (not self.objButtonLightEffect):
			return
		
		if newState == self.DEFAULT_BUTTON_STATE:
			self.objButtonBaseNorm.Show()
			self.objButtonBaseDown.Hide()
			self.objButtonIdentifier.Show()
			self.objButtonLightEffect.Hide()
		elif newState == self.HOVER_BUTTON_STATE:
			self.objButtonBaseNorm.Show()
			self.objButtonBaseDown.Hide()
			self.objButtonIdentifier.Show()
			self.objButtonLightEffect.Show()
		elif (newState == self.DOWN_BUTTON_STATE or newState == self.DISABLE_BUTTON_STATE):
			self.objButtonBaseNorm.Hide()
			self.objButtonBaseDown.Show()
			self.objButtonIdentifier.Show()
			self.objButtonLightEffect.Hide()
	
	def __OnRadioUp(self, forceEvent = False):
		if not self.isRadioButton:
			return
		
		if forceEvent is False:
			if self.lastButtonState == self.DOWN_BUTTON_STATE:
				return
		
		self.lastButtonState = self.DEFAULT_BUTTON_STATE
		self.__SwitchButtonBaseState(self.lastButtonState)
	
	def __OnRadioHover(self):
		if not self.isRadioButton:
			return
		
		if self.lastButtonState == self.DOWN_BUTTON_STATE:
			return
		
		self.lastButtonState = self.HOVER_BUTTON_STATE
		self.__SwitchButtonBaseState(self.lastButtonState)
	
	def __OnRadioDown(self, runEvent = True):
		if not self.isRadioButton:
			return
		
		if self.lastButtonState == self.DOWN_BUTTON_STATE:
			return
		
		self.lastButtonState = self.DOWN_BUTTON_STATE
		self.__SwitchButtonBaseState(self.lastButtonState)
		
		if runEvent is True:
			if self.clickEvent:
				apply(*self.clickEvent)
	
	def __OnUp(self, checkState = True):
		if self.isRadioButton:
			return
		
		if checkState and self.lastButtonState == self.DISABLE_BUTTON_STATE:
			return
		
		self.lastButtonState = self.DEFAULT_BUTTON_STATE
		self.__SwitchButtonBaseState(self.lastButtonState)
	
	def __OnHover(self):
		if self.isRadioButton:
			return
		
		if self.lastButtonState == self.DISABLE_BUTTON_STATE:
			return
		
		self.lastButtonState = self.HOVER_BUTTON_STATE
		self.__SwitchButtonBaseState(self.lastButtonState)
	
	def __OnDown(self):
		if self.isRadioButton:
			return
		
		if self.lastButtonState == self.DISABLE_BUTTON_STATE:
			return
		
		self.lastButtonState = self.DOWN_BUTTON_STATE
		self.__SwitchButtonBaseState(self.lastButtonState)
	
	def __OnUpAfterDown(self):
		if self.isRadioButton:
			return
		
		if self.lastButtonState == self.DISABLE_BUTTON_STATE:
			return
		
		if self.wndAnimationController and self.wndAnimationController.IsIn():
			self.__OnHover()
			if self.clickEvent:
				apply(*self.clickEvent)
	
		#@ Public Methods
	def SetUp(self):
		self.__OnRadioUp(True)
	
	def Down(self):
		self.__OnRadioDown(False)
	
	def SAFE_SetClickEvent(self, event, *args):
		self.clickEvent = (ui.__mem_func__(event), args)
	
	def EnableButton(self):
		if not self.isRadioButton:
			self.__OnUp(False)
	
	def DisableButton(self):
		if not self.isRadioButton:
			self.lastButtonState = self.DISABLE_BUTTON_STATE
			self.__SwitchButtonBaseState(self.lastButtonState)
	
	def OnUpdate(self):
		if (self.isRadioButton or self.lastButtonState == self.DISABLE_BUTTON_STATE):
			return
		
		if (self.wndAnimationController and not self.wndAnimationController.IsIn()) and self.lastButtonState != self.DEFAULT_BUTTON_STATE:
			self.__OnUp()
	
	def BindButtonObjectImages(self, strBaseImageNorm, strBaseImageDown, strButtonIndetifier, strButtonLighEffect):
		if self.objButtonBaseNorm:
			self.objButtonBaseNorm.LoadImage(strBaseImageNorm)
		
		if self.objButtonBaseDown:
			self.objButtonBaseDown.LoadImage(strBaseImageDown)
		
		if self.objButtonIdentifier:
			self.objButtonIdentifier.LoadImage(strButtonIndetifier)
		
		if self.objButtonLightEffect:
			self.objButtonLightEffect.LoadImage(strButtonLighEffect)
		
		self.lastButtonState = self.DEFAULT_BUTTON_STATE
		
		self.__ReloadButtonSize([self.objButtonBaseNorm.GetWidth(), self.objButtonBaseNorm.GetHeight()])
		self.__SwitchButtonBaseState(self.lastButtonState)
	
	def SetAlphaSensitiveImages(self, state):
		if state:
			self.AddFlag('alpha_sensitive')
			
			if self.objButtonBaseNorm:
				self.objButtonBaseNorm.AddFlag('alpha_sensitive')
			
			if self.objButtonBaseDown:
				self.objButtonBaseDown.AddFlag('alpha_sensitive')
			
			if self.objButtonIdentifier:
				self.objButtonIdentifier.AddFlag('alpha_sensitive')
			
			if self.objButtonLightEffect:
				self.objButtonLightEffect.AddFlag('alpha_sensitive')
	
	def Show(self):
		super(MoreiraButton, self).Show()
	
	def Hide(self):
