def DefineSkillIndexDict():
	global SKILL_INDEX_DICT
	SKILL_INDEX_DICT = {
		JOB_WARRIOR: {
			1: (1, 2, 3, 4, 5, 0, 0, 0, 137, 0, 138, 0, 139, 0,),
