MAX_STATUS_BYTES = 159
HEX_DIGITS = "0123456789abcdefABCDEF"


def decode_status(vid_arg, hex_arg):
	try:
		vid = int(vid_arg)
	except (ValueError, TypeError):
		return None
	if vid <= 0 or vid > 0xffffffff:
		return None
	if not hex_arg or len(hex_arg) > MAX_STATUS_BYTES * 2 or len(hex_arg) % 2:
		return None
	chars = []
	for i in range(0, len(hex_arg), 2):
		pair = hex_arg[i:i + 2]
		if pair[0] not in HEX_DIGITS or pair[1] not in HEX_DIGITS:
			return None
		value = int(pair, 16)
		if value < 32 or value == 127:
			return None
		chars.append(chr(value))
	
	if vid >= 0x80000000:
		vid -= 0x100000000
	return vid, "".join(chars)









PLACEHOLDER_OPEN = "{"
PLACEHOLDER_CLOSE = "}"
PLACEHOLDER_MAX = 8


def client_language():
	try:
		import systemSetting
		return systemSetting.GetLanguage()
	except Exception:
		return "pl"


def monster_name(vnum):
	try:
		import nonplayer
		name = nonplayer.GetMonsterName(vnum)
		if name:
			return name
	except Exception:
		pass
	return "?"


def item_name(vnum):
	
	
	
	try:
		import item
		item.SelectItem(vnum)
		name = item.GetItemName()
		if name:
			return name
	except Exception:
		pass
	return "?"


def expand_names(text, language=None):
	"""Every {m<vnum>} and {i<vnum>} replaced by the client's own name for it."""
	if language is None:
		language = client_language()
	out = []
	i = 0
	while i < len(text):
		start = text.find(PLACEHOLDER_OPEN, i)
		if start < 0:
			out.append(text[i:])
			break
		end = text.find(PLACEHOLDER_CLOSE, start)
		out.append(text[i:start])
		if end < 0:
			out.append(text[start:])
			break
		token = text[start + 1:end]
		kind, digits = token[:1], token[1:]
		if kind in ("m", "i") and digits.isdigit() and len(digits) <= PLACEHOLDER_MAX:
			vnum = int(digits)
			out.append(monster_name(vnum) if kind == "m" else item_name(vnum))
		elif kind == "q" and digits and len(digits) <= 64 and all(c.isalnum() or c == "_" for c in digits):
			from playerbot_quest_titles import TITLES
			pair = TITLES.get(digits)
			if pair is None:
				report_missing_status('quest:' + digits)
				pair = (digits, digits)
			out.append(pair[0 if language == "pl" else 1])
		else:
			out.append(text[start:end + 1])
		i = end + 1
	return "".join(out)


def choose_status(vid_arg, hex_arg, hex_en=None, language=None):
	"""(vid, text) to draw, or None: the English line for a non-Polish client."""
	status = decode_status(vid_arg, hex_arg)
	if status is None:
		return None
	if hex_en is None:
		return status
	if language is None:
		language = client_language()
	if language == "pl":
		return status[0], expand_names(status[1], "pl")
	english = decode_status(vid_arg, hex_en)
	if english is None:
		return status
	return english[0], expand_names(english[1], language)


_missing_status_keys = set()


def report_missing_status(key):
    if key in _missing_status_keys or len(_missing_status_keys) >= 1024:
        return
    _missing_status_keys.add(key)
    try:
        with open('playerbot_missing_translations.tsv', 'a') as report:
            report.write('%s\t%s\n' % (client_language(), key[:100]))
    except Exception:
        pass


def keyed_status(vid_arg, key, pl_args, en_args, language=None):
    if language is None:
        language = client_language()
    try:
        from playerbot_status_keys import STATUS_KEYS
    except ImportError:
        STATUS_KEYS = {}
    pair = STATUS_KEYS.get(key)
    if pair is None:
        report_missing_status(key)
        return decode_status(vid_arg, ''.join('%02x' % ord(c) for c in key))
    import re
    template = pair[0 if language == 'pl' else 1]
    parts = re.split(r'(%[-+ .0-9lhz]*[sduif])', template)
    expected = (len(parts)-1)//2
    encoded = pl_args if language == 'pl' else en_args
    args = []
    
    
    if encoded == '-' and expected == 1 and parts[1].endswith('s'):
        args.append('')
    if encoded != '-':
        if len(encoded) > 640:
            return None
        for word in encoded.split('.'):
            value = decode_status(vid_arg, word) if word != '-' else (0, '')
            if value is None:
                return None
            args.append(value[1])
    if expected != len(args):
        report_missing_status(key + ':arguments')
        return decode_status(vid_arg, ''.join('%02x' % ord(c) for c in key))
    text = ''.join(args[(n-1)//2] if n % 2 else part for n, part in enumerate(parts))
    decoded = decode_status(vid_arg, ''.join('%02x' % ord(c) for c in text[:MAX_STATUS_BYTES]))
    return (decoded[0], expand_names(decoded[1], language)) if decoded else None


def show(vid_arg, hex_arg, *rest):
    if hex_arg == 'k1':
        status = keyed_status(vid_arg, *rest) if len(rest) == 3 else None
    else:
        status = choose_status(vid_arg, hex_arg, rest[0] if rest else None)
    if status is None:
        return
    import textTail
    textTail.RegisterChatTail(status[0], status[1])

















