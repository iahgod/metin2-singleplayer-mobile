import dbg
import app
import localeInfo
import wndMgr
import systemSetting
import mouseModule
import networkModule
import uiCandidate
import constInfo
import musicInfo
import stringCommander
import ui

if constInfo.ENABLE_PASTE_FEATURE:
	ui.EnablePaste(True)

def RunApp():
	mouseModule.mouseController = mouseModule.CMouseController() 

	musicInfo.LoadLastPlayFieldMusic()

	app.SetHairColorEnable(constInfo.HAIR_COLOR_ENABLE)
	app.SetArmorSpecularEnable(constInfo.ARMOR_SPECULAR_ENABLE)
	app.SetWeaponSpecularEnable(constInfo.WEAPON_SPECULAR_ENABLE)

	app.SetMouseHandler(mouseModule.mouseController)
	wndMgr.SetMouseHandler(mouseModule.mouseController)

	width = systemSetting.GetWidth()
	height = systemSetting.GetHeight()
	if systemSetting.IsScaleMode():
		width, height = systemSetting.GetScaledResolution()

	wndMgr.SetScreenSize(width, height)

	try:
		app.Create(localeInfo.APP_TITLE, width, height, 1)

	except RuntimeError, msg:
		msg = str(msg)
		if "CREATE_DEVICE" == msg:
			dbg.LogBox("Sorry, Your system does not support 3D graphics,\r\nplease check your hardware and system configeration\r\nthen try again.")
		else:
			dbg.LogBox("Metin2.%s" % msg)
		return

	app.SetCamera(1500.0, 30.0, 0.0, 180.0)

	
	if not mouseModule.mouseController.Create():
		return

	mainStream = networkModule.MainStream()
	mainStream.Create()
	mainStream.SetLogoPhase()

	app.Loop()

	mainStream.Destroy()

	if mouseModule.mouseController: 
		mouseModule.mouseController.Destroy()
		mouseModule.mouseController = None

RunApp()
# The camera's field of view on a slider (Tyrion, 2 October): a row of the
# system options, "FOV: 30", from 20 to 70, taking effect at once. The exe
# has had it all along - app.SetFov sets CPythonApplication's m_cameraFov,
# which every frame's perspective and view frustum read - and only the
# cinematic camera used it. The value is in qol_fov.cfg beside the client
# and set again at every entry into the game; without the file nothing is
# set and the game keeps its own 30.
#
# Python 2.7 as the client has it, and 3 for the tests.
import clientqol

CONFIG_FILE = 'qol_fov.cfg'
FOV_MIN = 20
FOV_MAX = 70


FOV_DEFAULT = 30


def GetFov():
	return max(FOV_MIN, min(FOV_MAX, clientqol.LoadInt(CONFIG_FILE, FOV_DEFAULT)))


def Apply(fov):
	import app
	app.SetFov(float(fov))


def OnGameStart(game):
	fov = GetFov()
	if fov != FOV_DEFAULT:
		Apply(fov)
	# The cinematic camera's keys step the FOV by two from game.cameraFov,
	# which GameWindow sets to 30: from the player's own instead, or its
	# first step would jump back to 32.
	if hasattr(game, 'cameraFov'):
		game.cameraFov = fov


def SliderFov(pos):
	"""The whole FOV a slider's position (0.0 - 1.0) stands for."""
	return int(round(FOV_MIN + pos * (FOV_MAX - FOV_MIN)))


def AttachOptions(dlg):
	import ui
	board, y = clientqol.OptionRow(dlg)
	if not board:
		return
	
	
	label = clientqol.OptionLabel(board, clientqol.LABEL_X, y, '')
	slider = ui.SliderBar()
	slider.SetParent(board)
	slider.SetPosition(clientqol.COLUMN_X, y)
	slider.Show()
	dlg.qolFovWidgets = (label, slider)

	from _weakref import proxy
	label = proxy(label)
	slider = proxy(slider)  
	state = {'fov': GetFov()}

	def OnSlide():
		fov = SliderFov(slider.GetSliderPos())
		if fov == state['fov']:
			return
		state['fov'] = fov
		Apply(fov)
		clientqol.SaveInt(CONFIG_FILE, fov)
		label.SetText('FOV: %d' % fov)

	slider.SetSliderPos(float(state['fov'] - FOV_MIN) / (FOV_MAX - FOV_MIN))
	slider.SetEvent(OnSlide)
	label.SetText('FOV: %d' % state['fov'])
# Frames per second under the minimap (Tyrion, 2 October): "FPS: 60" under
# the clock, twice a second from app.GetRenderFPS(), in the minimap's
# OpenWindow, so it hides with the map. A row of the system options switches
# it, at once; the choice is in qol_fps.cfg beside the client, and without
# the file the counter is off, as the game has always been. The script's own
# FPSInfo, hidden for good, stays as it is: the clock stands there.
#
# Python 2.7 as the client has it, and 3 for the tests.
import clientqol

CONFIG_FILE = 'qol_fps.cfg'


LINE_X = 70
LINE_Y = 192
REFRESH_SECONDS = 0.5

_state = {'on': None}
_minimaps = []  


def IsEnabled():
	if _state['on'] is None:
		_state['on'] = clientqol.LoadInt(CONFIG_FILE, 0) == 1
	return _state['on']


def _Refresh(minimap):
	line = getattr(minimap, 'qolFpsLine', None)
	if not line:
		return
	if IsEnabled():
		minimap.qolFpsNext = 0.0
		line.Show()
	else:
		line.Hide()


def AttachMinimap(minimap):
	import ui
	from _weakref import ref
	line = ui.TextLine()
	line.SetParent(minimap.OpenWindow)
	line.SetPosition(LINE_X, LINE_Y)
	line.SetHorizontalAlignCenter()
	line.SetOutline()
	minimap.qolFpsLine = line
	minimap.qolFpsNext = 0.0
	_minimaps.append(ref(minimap))
	_Refresh(minimap)


def UpdateMinimap(minimap):
	line = getattr(minimap, 'qolFpsLine', None)
	if not line or not line.IsShow():
		return
	import clientclock
	now = clientclock.Now()
	if now < minimap.qolFpsNext:
		return
	minimap.qolFpsNext = now + REFRESH_SECONDS
	import app
	line.SetText('FPS: %d' % int(app.GetRenderFPS()))


def SetEnabled(on):
	_state['on'] = bool(on)
	clientqol.SaveInt(CONFIG_FILE, 1 if on else 0)
	for minimap in clientqol.LiveRefs(_minimaps):
		_Refresh(minimap)


def _OnClick(dlg, on):
	SetEnabled(on)
	clientqol.SetRadio(dlg.qolFpsButtons, on)


def AttachOptions(dlg):
	import playerbot_lang
	from _weakref import proxy
	board, y = clientqol.OptionRow(dlg)
	if not board:
		return
	dlg.qolFpsLabel = clientqol.OptionLabel(board, clientqol.LABEL_X, y + 2,
		playerbot_lang.T('Licznik FPS', 'FPS counter'))
	
	dlg.qolFpsButtons = clientqol.OnOffButtons(board, y, _OnClick, proxy(dlg))
	clientqol.SetRadio(dlg.qolFpsButtons, IsEnabled())
# The map's name under the minimap (Tyrion, 2 October): where the stock
# script shows the character's position, "(4123, 8745)", the name of the map
# instead - "Wioska Jinno" - from localeInfo.MINIMAP_ZONE_NAME_DICT, the
# names the map under M is titled with, so in the player's language; a map
# the table does not name shows its code without "metin2_map_". A row of
# the system options switches it, at once; the choice is in qol_mapname.cfg
# beside the client, and without the file the position stays, as it was.
# The stock PositionInfo goes on being written every frame, only hidden, and
# with constInfo.MINIMAP_POSITIONINFO_ENABLE at 0 neither line shows.
#
# And whatever the switch: the server's line over it, "Metin2 SinglePlayer,
# CH1", is centred on x 70 of a window that stands against the screen's
# right edge, so a line wider than the window ran off the screen. A line
# wider than MAX_CENTERED_WIDTH ends at RIGHT_X and grows to the left; the
# map's name too.
#
# Python 2.7 as the client has it, and 3 for the tests.
import clientqol

CONFIG_FILE = 'qol_mapname.cfg'
CENTER_X = 70
RIGHT_X = 132
MAX_CENTERED_WIDTH = 128

_state = {'on': None}
_minimaps = []  


def IsEnabled():
	if _state['on'] is None:
		_state['on'] = clientqol.LoadInt(CONFIG_FILE, 0) == 1
	return _state['on']


def MapName(mapName):
	try:
		import localeInfo
		name = localeInfo.MINIMAP_ZONE_NAME_DICT.get(mapName, '')
		if name:
			return name
	except Exception:
		pass
	for prefix in ('metin2_map_', 'map_'):
		if mapName.startswith(prefix):
			return mapName[len(prefix):]
	return mapName


def _PositionAllowed():
	try:
		import constInfo
		return constInfo.MINIMAP_POSITIONINFO_ENABLE != 0
	except Exception:
		return True


def Fit(textLine, y):
	"""`textLine` at `y`, centred while it fits, else ending at RIGHT_X."""
	if textLine.GetTextSize()[0] > MAX_CENTERED_WIDTH:
		textLine.SetHorizontalAlignRight()
		textLine.SetPosition(RIGHT_X, y)
	else:
		textLine.SetHorizontalAlignCenter()
		textLine.SetPosition(CENTER_X, y)


def _Refresh(minimap):
	line = getattr(minimap, 'qolMapLine', None)
	stock = getattr(minimap, 'positionInfo', None)
	if not line or not stock:
		return
	minimap.qolMapShown = None
	if not _PositionAllowed():
		line.Hide()
	elif IsEnabled():
		stock.Hide()
		line.Show()
	else:
		line.Hide()
		stock.Show()


def AttachMinimap(minimap):
	import ui
	from _weakref import ref
	stock = minimap.positionInfo
	line = ui.TextLine()
	line.SetParent(minimap.OpenWindow)
	line.SetPosition(CENTER_X, stock.GetLocalPosition()[1])
	line.SetHorizontalAlignCenter()
	line.SetOutline()
	minimap.qolMapLine = line
	minimap.qolMapShown = None
	minimap.qolServerShown = None
	_minimaps.append(ref(minimap))
	_Refresh(minimap)


def UpdateMinimap(minimap):
	server = getattr(minimap, 'serverInfo', None)
	if server:
		text = server.GetText()
		if text != getattr(minimap, 'qolServerShown', None):
			minimap.qolServerShown = text
			Fit(server, server.GetLocalPosition()[1])

	line = getattr(minimap, 'qolMapLine', None)
	if not line or not line.IsShow():
		return
	mapName = getattr(minimap, 'mapName', '')
	if not mapName:
		import background
		mapName = background.GetCurrentMapName() or ''
	if mapName == minimap.qolMapShown:
		return
	minimap.qolMapShown = mapName
	line.SetText(MapName(mapName))
	Fit(line, line.GetLocalPosition()[1])


def SetEnabled(on):
	_state['on'] = bool(on)
	clientqol.SaveInt(CONFIG_FILE, 1 if on else 0)
	for minimap in clientqol.LiveRefs(_minimaps):
		_Refresh(minimap)


def _OnClick(dlg, on):
	SetEnabled(on)
	clientqol.SetRadio(dlg.qolMapNameButtons, on)


def AttachOptions(dlg):
	import playerbot_lang
	from _weakref import proxy
	board, y = clientqol.OptionRow(dlg)
	if not board:
		return
	dlg.qolMapNameLabel = clientqol.OptionLabel(board, clientqol.LABEL_X, y + 2,
		playerbot_lang.T('Nazwa mapy', 'Map name'))
	dlg.qolMapNameButtons = clientqol.OnOffButtons(board, y, _OnClick, proxy(dlg))
	clientqol.SetRadio(dlg.qolMapNameButtons, IsEnabled())
# What came into the bag, lit (Tyrion, 2 October). The exe and the server
# already light a new item - both build ENABLE_HIGHLIGHT_NEW_ITEM: the
# server's item packet says "highlight" when CItem::AddToCharacter finds the
# item's last owner was somebody else, and game.py's BINARY_Highlight_Item
# hands the cell to InventorySlotManager.HighlightSlot, whose
# SLOT_STATE_NEW_ITEM lights it (ActivateSlot) until the mouse goes over it
# (OnSlotMouseOverIn). What they miss is a stack that grew - a potion picked
# up onto the potions, which the server counts into the stack it has - and an
# item that was the character's before, out of the box or back from a trade.
#
# So the bag is compared with itself at every refresh of it: a cell whose
# item or count changed is lit when the bag as a whole holds more of that
# item than it did, which a move, a split, a merge or the server's "Scal i
# uporzadkuj" never does. It lights through the same state, so the light
# looks and goes as the stock one. For WARMUP_SECONDS after the window is
# made - at the login and after every warp, the game window being a new one
# each time - the server sends the whole bag again and nothing is lit. And a
# cell lit whose item has left it is put out: the stock state stayed with
# the cell and lit it empty.
#
# Python 2.7 as the client has it, and 3 for the tests.
WARMUP_SECONDS = 4.0


def _Snapshot():
	import player
	getIndex = player.GetItemIndex
	getCount = player.GetItemCount
	cells = []
	totals = {}
	for cell in range(player.INVENTORY_PAGE_SIZE * player.INVENTORY_PAGE_COUNT):
		vnum = getIndex(cell)
		count = getCount(cell) if vnum else 0
		cells.append((vnum, count))
		if vnum:
			totals[vnum] = totals.get(vnum, 0) + count
	return cells, totals


def NewCells(oldCells, oldTotals, cells, totals):
	"""The cells to light: changed, and holding an item the bag has more of."""
	lit = []
	for cell in range(min(len(cells), len(oldCells))):
		vnum = cells[cell][0]
		if not vnum or cells[cell] == oldCells[cell]:
			continue
		if totals.get(vnum, 0) > oldTotals.get(vnum, 0):
			lit.append(cell)
	return lit


def OnRefresh(inventoryWindow):
	"""InventoryWindow.RefreshBagSlotWindow for the bag, before the slot
	states are drawn (RefreshAllSlots)."""
	manager = getattr(inventoryWindow, 'inventorySlotStateMgr', None)
	if not manager:
		return
	import clientclock
	(cells, totals) = _Snapshot()
	now = clientclock.Now()
	state = getattr(inventoryWindow, 'qolNewItems', None)
	if state is None:
		inventoryWindow.qolNewItems = {'start': now, 'cells': cells, 'totals': totals}
		return
	(oldCells, oldTotals) = (state['cells'], state['totals'])
	state['cells'] = cells
	state['totals'] = totals

	newState = manager.SLOT_STATE_NEW_ITEM
	slotStates = manager.slotStates
	for cell in range(min(len(cells), len(slotStates))):
		if not cells[cell][0] and slotStates[cell] == newState:
			slotStates[cell] = manager.SLOT_STATE_NONE

	if now - state['start'] < WARMUP_SECONDS:
		return
	
	
	for cell in NewCells(oldCells, oldTotals, cells, totals):
		if cell < len(slotStates) and slotStates[cell] == manager.SLOT_STATE_NONE:
			manager.HighlightSlot(cell)
# Snow on every map, switched in the system options (Tyrion, 2 October): the
# Christmas event's snow, background.EnableSnow, which the exe has had all
# along and the server's xmas_snow drives - the night of this world is that
# flag too (playerbot_config.h's ManagePlayerBotNight), and it snows then on
# the maps game.py's __IsXMasMap names.
#
# Three choices, kept in qol_snow.cfg beside the client:
#
#   "On"   (1) snows everywhere, after every warp (GameWindow.Close destroys
#              the background, and the snow with it) and whatever the
#              server's xmas_snow says afterwards;
#   "Off"  (0) never snows: what the server's xmas_snow puts up - the world's
#              night at 22:00 among it - is taken down again at once
#              (7c91d768, 7 October: "the snow effect is running even if it
#              is OFF");
#   "Auto" (2) gives the snow to the server: what its last xmas_snow on this
#              map put up stays, the rest goes. Without the file it is this,
#              and nothing here touches the snow.
#
# Until 7 October the row had "On" and "Off" only, and "Off" was what "Auto"
# is now - so a player who never touched it saw "Off" lit while the night
# snowed. A file of 0 was written by that "Off", which the player chose to
# have no snow: it is "Off" now. The Christmas song of xmas_snow is the
# server's either way. How hard it snows is the exe's own, a fixed number of
# flakes; a script cannot change it.
#
# Python 2.7 as the client has it, and 3 for the tests.
import clientqol

CONFIG_FILE = 'qol_snow.cfg'

OFF = 0
ON = 1
AUTO = 2
MODES = (OFF, ON, AUTO)



_state = {'mode': None, 'server': False}


def GetMode():
	if _state['mode'] is None:
		mode = clientqol.LoadInt(CONFIG_FILE, AUTO)
		_state['mode'] = mode if mode in MODES else AUTO
	return _state['mode']


def IsEnabled():
	"""Whether the player has it snow everywhere."""
	return GetMode() == ON


def _Snow(on):
	import background
	background.EnableSnow(1 if on else 0)


def OnGameStart():
	
	_state['server'] = False
	if GetMode() == ON:
		_Snow(True)


def OnServerSnow(on):
	"""After the stock __XMasSnow_Enable put the snow up (on) or took it
	down: the player's own choice stays."""
	_state['server'] = bool(on)
	mode = GetMode()
	if mode == ON and not on:
		_Snow(True)
	elif mode == OFF and on:
		_Snow(False)


def SetMode(mode):
	if mode not in MODES:
		mode = AUTO
	_state['mode'] = mode
	clientqol.SaveInt(CONFIG_FILE, mode)
	_Snow(mode == ON or (mode == AUTO and _state['server']))


def _OnClick(dlg, mode):
	SetMode(mode)
	clientqol.SetChoice(dlg.qolSnowButtons, mode)


def AttachOptions(dlg):
	import playerbot_lang
	from _weakref import proxy
	T = playerbot_lang.T
	board, y = clientqol.OptionRow(dlg)
	if not board:
		return
	dlg.qolSnowLabel = clientqol.OptionLabel(board, clientqol.LABEL_X, y + 2, T('\x8cnieg', 'Snow'))
	dlg.qolSnowButtons = clientqol.ChoiceButtons(board, y, (
		(clientqol.BUTTON_X[0], T('W\xb3.', 'On'), ON),
		(clientqol.BUTTON_X[1], T('Wy\xb3.', 'Off'), OFF),
		(clientqol.BUTTON_X[2], T('Auto', 'Auto'), AUTO)), _OnClick, proxy(dlg))
	clientqol.SetChoice(dlg.qolSnowButtons, GetMode())






































GRACE_SECONDS = 3.0

_state = {'due': None}


def _Curtain():
	"""The stock curtain and the done events waiting on it: (None, ()) before
	the first dialog and after the game window's end, which deletes it."""
	
	import uiQuest
	curtain = uiQuest.QuestDialog.__dict__.get('QuestCurtain')
	events = getattr(uiQuest.QuestCurtain, 'OnDoneEventList', None) or ()
	return curtain, events


def _Stands(curtain):
	"""Neither going up nor gone: a curtain no dialog moves."""
	return curtain is not None and getattr(curtain, 'CurtainMode', 0) >= 0


def _Now(now):
	if now is not None:
		return now
	import clientclock
	return clientclock.Now()


def OnDialogOpened():
	"""A dialog opened: the server is talking, and the dialog ends its own way."""
	_state['due'] = None


def OnLastDialogClosed(now=None):
	"""The last open dialog closed. True when it waits for the server: closed on
	an answer, the curtain standing and a done event pending."""
	curtain, events = _Curtain()
	if not events or not _Stands(curtain):
		_state['due'] = None
		return False
	_state['due'] = _Now(now) + GRACE_SECONDS
	return True


def Waiting():
	return _state['due'] is not None


def Update(now=None):
	"""True when the curtain was sent up for a "[DONE]" that never came."""
	due = _state['due']
	if due is None or _Now(now) < due:
		return False
	_state['due'] = None
	curtain, events = _Curtain()
	if not events or not _Stands(curtain):
		return False
	curtain.CurtainMode = -1
	_Trace(len(events))
	return True


def _Trace(count):
	try:
		import dbg
		dbg.TraceError('QUEST_CURTAIN: no [DONE] %.0f s after an answer; the windows %d dialog(s) hid come back' %
			(GRACE_SECONDS, count))
	except Exception:
		pass


def Reset():
	_state['due'] = None


class Keeper(object):
	"""One of the game's updateables (game.py's CreateUpdateables): the wait is
	looked at every frame while there is one, and the game window's end
	forgets it - the interface closes the curtain then itself."""

	def CanUpdate(self):
		return Waiting()

	def OnUpdate(self):
		Update()

	def Destroy(self):
		Reset()


def GetKeeper():
	return Keeper()
import sys
libpath = '..\\..\\Extern\\Py2Lib\\lib'
sys.path.append(libpath)


import imp
fp, pathname, description = imp.find_module('utils', [libpath])
utils = imp.load_module('utils', fp, pathname, description)
import cythonizer

pys = utils.findMatchedFiles(".", "*.py")
pys.remove('RootlibCythonizer.py')
moduleLst = cythonizer.run(pys, forceRecompile=True)
moduleNameLst = []
sourceFileLst = []
import os.path
for m in moduleLst:
	for source in m.sources:
		base, ext = os.path.splitext(source)
		moduleName = base.split('/')[-1]
		moduleNameLst.append(moduleName)
		sourceFileLst.append(base + (".cpp" if "c++" == m.language else ".c"))

import sourceWriter

sourceFileName = sourceWriter.run(moduleNameLst, 'rootlib')
print "%s create successful." % sourceFileName












# The safebox's "Scal i uporzadkuj", and its stacks moved by count across the
# safebox and the bag or inside the safebox (uisafebox.py, uiinventory.py;
# blasty's proposal, 19 September).
#
# The client's safebox packets name cells and no count - SendSafeboxCheckinPacket,
# SendSafeboxCheckoutPacket, SendSafeboxItemMovePacket - so a part of a stack,
# and a stack dropped on the same item, go to the server as a command
# ("/safebox_put", "/safebox_take", "/safebox_move") and come back as
# "SafeboxTransferResult <op> <code> <units>" (game.py). A whole stack dropped
# on a free place still goes by the packet, as it always did. The button in the
# safebox's title bar sends "/safebox_arrange" and hears
# "SafeboxArrangeResult <code> <moved> <merged> <units>". The server's side is
# playerbot_arrange.cpp.
#
# Only the four bag pages take part; the belt, the horse's page and the dragon
# soul window keep the packets. A transfer that works says nothing - the two
# windows show it - and a refusal says why.
#
# The texts are CP1250, the client's own, written as escapes so the file stays
# ASCII, each a Polish and English pair (playerbot_lang.T): English for a
# client set to any language but Polish. Python 2.7 as the client has it.

import app
import clientclock
import chat
import mouseModule
import net
import player
import safebox
from playerbot_lang import T

PENDING_TIMEOUT = 5.0


RESULT_DONE = 0
RESULT_NOTHING = 1
RESULT_BUSY = 2
RESULT_COOLDOWN = 3
RESULT_NO_LAYOUT = 4
RESULT_DEAD = 5
RESULT_INCONSISTENT = 6
RESULT_UNSUPPORTED = 7
RESULT_BAD_REQUEST = 8
RESULT_NO_SAFEBOX = 9


OP_PUT = 1
OP_TAKE = 2
OP_MOVE = 3

TRANSFER_DONE = 0
TRANSFER_BUSY = 1
TRANSFER_NO_SAFEBOX = 2
TRANSFER_NO_ITEM = 3
TRANSFER_OCCUPIED = 4
TRANSFER_FULL = 5
TRANSFER_REFUSED = 6
TRANSFER_BAD_REQUEST = 7
TRANSFER_COOLDOWN = 8
TRANSFER_UNSUPPORTED = 9
TRANSFER_DEAD = 10

MSG_ARRANGE_DONE = T('Uporz\xb9dkowano magazyn: przestawiono %d, scalono stos\xf3w: %d.',
	'Storage sorted: %d moved, %d stacks merged.')
MSG_ARRANGE_NOTHING = T('Magazyn jest ju\xbf uporz\xb9dkowany.', 'The storage is already sorted.')
MSG_ARRANGE_BUSY = T('Nie mo\xbfna teraz uporz\xb9dkowa\xe6 magazynu - zamknij handel, sklep lub inne okno.',
	'The storage cannot be sorted now - close the trade, the shop or the other window.')
MSG_ARRANGE_COOLDOWN = T('Odczekaj chwil\xea przed kolejnym porz\xb9dkowaniem.', 'Wait a moment before sorting again.')
MSG_ARRANGE_NO_LAYOUT = T('Nie uda\xb3o si\xea u\xb3o\xbfy\xe6 magazynu - nic nie zmieniono.',
	'The storage could not be laid out - nothing was changed.')
MSG_ARRANGE_DEAD = T('Nie mo\xbfesz porz\xb9dkowa\xe6 magazynu po \x9cmierci.', 'You cannot sort the storage while dead.')
MSG_ARRANGE_INCONSISTENT = T('Magazyn jest w nieoczekiwanym stanie - nic nie zmieniono. Zg\xb3o\x9c to na Discordzie.',
	'The storage is in an unexpected state - nothing was changed. Please report it on Discord.')
MSG_NO_SAFEBOX = T('Magazyn nie jest otwarty.', 'The storage is not open.')
MSG_UNSUPPORTED = T('Serwer nie obs\xb3uguje tej funkcji magazynu.', 'The server does not support this storage feature.')
MSG_ATTACHED = T('Od\xb3\xf3\xbf najpierw przedmiot trzymany kursorem.', 'Put down the item on your cursor first.')
MSG_SHOP = T('Nie mo\xbfna porz\xb9dkowa\xe6 magazynu podczas otwierania sklepu.',
	'The storage cannot be sorted while a shop is being opened.')

MSG_TRANSFER_BUSY = T('Nie mo\xbfna teraz przenie\x9c\xe6 przedmiotu - zamknij handel, sklep lub inne okno.',
	'The item cannot be moved now - close the trade, the shop or the other window.')
MSG_TRANSFER_NO_ITEM = T('Tego przedmiotu ju\xbf tam nie ma.', 'That item is not there any more.')
MSG_TRANSFER_OCCUPIED = T('Na tym polu le\xbfy inny przedmiot.', 'Another item lies in that slot.')
MSG_TRANSFER_FULL = T('Ten stos jest ju\xbf pe\xb3ny.', 'That stack is full.')
MSG_TRANSFER_REFUSED = T('Tego przedmiotu nie mo\xbfna tam prze\xb3o\xbfy\xe6.', 'That item cannot be put there.')
MSG_TRANSFER_BAD_REQUEST = T('Nie mo\xbfna tam prze\xb3o\xbfy\xe6 przedmiotu.', 'No item can be put there.')
MSG_TRANSFER_COOLDOWN = T('Za szybko - spr\xf3buj jeszcze raz.', 'Too fast - try again.')
MSG_TRANSFER_DEAD = T('Nie mo\xbfesz przek\xb3ada\xe6 przedmiot\xf3w po \x9cmierci.', 'You cannot move items while dead.')

_state = {'arrangeUntil': 0.0}


def _int(value):
	try:
		return int(value)
	except (TypeError, ValueError):
		return -1


def BagCells():
	return player.INVENTORY_PAGE_SIZE * player.INVENTORY_PAGE_COUNT


def _IsWhole(count, have):
	return count <= 0 or count >= have


def _Count(count, have):
	if _IsWhole(count, have):
		return 0
	return count


def IsArrangePending():
	return clientclock.Now() < _state['arrangeUntil']


def RequestArrange():
	if IsArrangePending():
		return False
	if mouseModule.mouseController.isAttached():
		chat.AppendChat(chat.CHAT_TYPE_INFO, MSG_ATTACHED)
		return False
	
	
	import uiPrivateShopBuilder
	if uiPrivateShopBuilder.IsBuildingPrivateShop():
		chat.AppendChat(chat.CHAT_TYPE_INFO, MSG_SHOP)
		return False
	_state['arrangeUntil'] = clientclock.Now() + PENDING_TIMEOUT
	net.SendChatPacket('/safebox_arrange')
	return True


def DropInSafebox(srcPos, dstPos, count, occupied):
	"""A safebox stack dropped on a safebox cell."""
	if srcPos == dstPos:
		return
	have = safebox.GetItemCount(srcPos)
	if occupied or not _IsWhole(count, have):
		net.SendChatPacket('/safebox_move %d %d %d' % (srcPos, dstPos, _Count(count, have)))
	else:
		net.SendSafeboxItemMovePacket(srcPos, dstPos)


def DropIntoSafebox(invenType, cell, safePos, count, occupied):
	"""A stack of the bag dropped on a safebox cell."""
	if invenType == player.INVENTORY and 0 <= cell < BagCells():
		have = player.GetItemCount(cell)
		if occupied or not _IsWhole(count, have):
			net.SendChatPacket('/safebox_put %d %d %d' % (cell, safePos, _Count(count, have)))
			return
	if occupied:
		
		
		return
	net.SendSafeboxCheckinPacket(invenType, cell, safePos)


def DropIntoBag(safePos, cell, count, occupied):
	"""A safebox stack dropped on a cell of the bag."""
	if 0 <= cell < BagCells():
		have = safebox.GetItemCount(safePos)
		if occupied or not _IsWhole(count, have):
			net.SendChatPacket('/safebox_take %d %d %d' % (safePos, cell, _Count(count, have)))
			return
	if occupied:
		return
	net.SendSafeboxCheckoutPacket(safePos, cell)


def MakePickDialog(acceptEvent):
	"""The count dialog a stack is split with - the one the bag uses."""
	if getattr(app, 'ENABLE_CHEQUE_SYSTEM', 0):
		import uiPickETC
		dialog = uiPickETC.PickETCDialog()
	else:
		import uiPickMoney
		dialog = uiPickMoney.PickMoneyDialog()
	dialog.LoadDialog()
	dialog.SetAcceptEvent(acceptEvent)
	dialog.Hide()
	return dialog


def ArrangeMessage(code, moved, merged):
	if code == RESULT_DONE:
		return MSG_ARRANGE_DONE % (moved, merged)
	if code == RESULT_NOTHING:
		return MSG_ARRANGE_NOTHING
	if code == RESULT_BUSY:
		return MSG_ARRANGE_BUSY
	if code == RESULT_COOLDOWN:
		return MSG_ARRANGE_COOLDOWN
	if code == RESULT_NO_LAYOUT:
		return MSG_ARRANGE_NO_LAYOUT
	if code == RESULT_DEAD:
		return MSG_ARRANGE_DEAD
	if code == RESULT_INCONSISTENT:
		return MSG_ARRANGE_INCONSISTENT
	if code == RESULT_NO_SAFEBOX:
		return MSG_NO_SAFEBOX
	return MSG_UNSUPPORTED


def TransferMessage(code):
	"""What to say about a transfer; None when it worked."""
	if code == TRANSFER_DONE:
		return None
	if code == TRANSFER_BUSY:
		return MSG_TRANSFER_BUSY
	if code == TRANSFER_NO_SAFEBOX:
		return MSG_NO_SAFEBOX
	if code == TRANSFER_NO_ITEM:
		return MSG_TRANSFER_NO_ITEM
	if code == TRANSFER_OCCUPIED:
		return MSG_TRANSFER_OCCUPIED
	if code == TRANSFER_FULL:
		return MSG_TRANSFER_FULL
	if code == TRANSFER_REFUSED:
		return MSG_TRANSFER_REFUSED
	if code == TRANSFER_BAD_REQUEST:
		return MSG_TRANSFER_BAD_REQUEST
	if code == TRANSFER_COOLDOWN:
		return MSG_TRANSFER_COOLDOWN
	if code == TRANSFER_DEAD:
		return MSG_TRANSFER_DEAD
	return MSG_UNSUPPORTED


def OnArrangeResult(code='0', moved='0', merged='0', units='0'):
	_state['arrangeUntil'] = 0.0
	chat.AppendChat(chat.CHAT_TYPE_INFO, ArrangeMessage(_int(code), max(0, _int(moved)), max(0, _int(merged))))


def OnTransferResult(op='0', code='0', units='0'):
	text = TransferMessage(_int(code))
	if text:
		chat.AppendChat(chat.CHAT_TYPE_INFO, text)
"""Find a whole item footprint inside the currently usable shop area."""


def FindEmpty(columns, rows, occupied, width, height, allowed):
    if columns <= 0 or rows <= 0 or width <= 0 or height <= 0:
        return -1
    blocked = set()
    for anchor, itemWidth, itemHeight in occupied:
        x, y = anchor % columns, anchor // columns
        for dy in range(itemHeight):
            for dx in range(itemWidth):
                if 0 <= x + dx < columns and 0 <= y + dy < rows:
                    blocked.add((y + dy) * columns + x + dx)
    for anchor in range(columns * rows):
        x, y = anchor % columns, anchor // columns
        if x + width > columns or y + height > rows:
            continue
        if any(anchor + dy * columns + dx in blocked
               for dy in range(height) for dx in range(width)):
            continue
        if not all(allowed(anchor + dx, height) for dx in range(width)):
            continue
        return anchor
    return -1
