import ui
import playerbot_lang
from _weakref import proxy

class FleaMarketQuantityDialog(ui.BoardWithTitleBar):


	def __init__(self, market):
		ui.BoardWithTitleBar.__init__(self)
		self.market = proxy(market)
		self.data = None

		self.SetSize(430, 240)
		self.AddFlag("movable")
		self.AddFlag("float")
		self.SetTitleName(playerbot_lang.T("Kup czesc stosu", "Buy part of a stack"))
		self.SetCloseEvent(ui.__mem_func__(self.Close))

		self.SetAlpha(1.0)
		self.titleBar.SetTop()

		self.itemLine = self.__MakeText(215, 48)
		self.itemLine.SetHorizontalAlignCenter()
		self.availableLine = self.__MakeText(215, 74)
		self.availableLine.SetHorizontalAlignCenter()
		self.quantityLabel = self.__MakeText(104, 111, playerbot_lang.T("Ile sztuk:", "Quantity:"))

		self.inputBar = ui.Bar()
		self.inputBar.SetColor(0xFF676257)
		self.inputBar.SetParent(self)
		self.inputBar.SetPosition(214, 104)
		self.inputBar.SetSize(100, 32)
		self.inputBar.AddFlag("not_pick")
		self.inputBar.Show()

		self.quantityFill = ui.Bar()
		self.quantityFill.SetParent(self.inputBar)
		self.quantityFill.SetPosition(1, 1)
		self.quantityFill.SetSize(98, 30)
		self.quantityFill.SetColor(0xFF080808)
		self.quantityFill.AddFlag("not_pick")
		self.quantityFill.Show()

		self.quantityEdit = ui.EditLine()
		self.quantityEdit.SetParent(self.quantityFill)
		self.quantityEdit.SetFontName("Tahoma:16")
		self.quantityEdit.SetPosition(8, 6)
		self.quantityEdit.SetSize(84, 22)
		self.quantityEdit.SetMax(9)
		self.quantityEdit.SetNumberMode()
		self.quantityEdit.OnIMEUpdate = ui.__mem_func__(self.__OnQuantityChanged)
		self.quantityEdit.SAFE_SetReturnEvent(self.Accept)
		self.quantityEdit.Show()

		self.totalLine = self.__MakeText(215, 151)
		self.totalLine.SetHorizontalAlignCenter()
		self.buyButton = self.__MakeButton(107, 192, playerbot_lang.T("Kup", "Buy"), self.Accept)
		self.cancelButton = self.__MakeButton(225, 192, playerbot_lang.T("Anuluj", "Cancel"), self.Close)
		buttonsWidth = self.buyButton.GetWidth() + 28 + self.cancelButton.GetWidth()
		buttonsLeft = (430 - buttonsWidth) // 2
		self.buyButton.SetPosition(buttonsLeft, 202 - self.buyButton.GetHeight() // 2)
		self.cancelButton.SetPosition(buttonsLeft + self.buyButton.GetWidth() + 28,
		 202 - self.cancelButton.GetHeight() // 2)
		self.Hide()

	def __MakeText(self, x, y, text=""):
		line = ui.TextLine()
		line.SetFontName("Tahoma:16")
		line.SetParent(self)
		line.SetPosition(x, y)
		line.SetText(text)
		line.Show()
		return line

	def __MakeButton(self, x, y, text, event):
		button = ui.Button()
		button.SetParent(self)
		button.SetPosition(x, y)
		button.SetSize(98, 36)
		button.SetUpVisual("d:/ymir work/ui/public/middle_button_01.sub")
		button.SetOverVisual("d:/ymir work/ui/public/middle_button_02.sub")
		button.SetDownVisual("d:/ymir work/ui/public/middle_button_03.sub")
		button.SetText(text, font="Tahoma:16")
		button.SetEvent(ui.__mem_func__(event))
		button.Show()
		return button

	def __GetQuantity(self):
		if not self.data:
			return 0
		try:
			quantity = int(self.quantityEdit.GetText())
		except:
			quantity = 1
		return max(1, min(quantity, self.data["count"]))

	def __OnQuantityChanged(self):
		ui.EditLine.OnIMEUpdate(self.quantityEdit)
		self.__UpdatePrice()

	def __UpdatePrice(self):
		if not self.data:
			return
		quantity = self.__GetQuantity()
		price = self.market.GetStackPurchasePrice(self.data, quantity)
		self.totalLine.SetText(playerbot_lang.T("Do zaplaty za %d szt.: %s", "To pay for %d pcs.: %s")
		 % (quantity, self.market.FormatPrice(price)))

	def Open(self, data):
		self.data = data
		self.itemLine.SetText(self.market.GetItemName(data))
		self.availableLine.SetText(playerbot_lang.T("Dostepne: %d szt.", "In the stack: %d pcs.") % data["count"])
		self.quantityEdit.SetText("1")
		self.__UpdatePrice()
		self.Show()
		self.SetTop()
		self.SetCenterPosition()
		self.quantityEdit.SetFocus()

	def Accept(self):
		if not self.data:
			return
		data = self.data
		quantity = self.__GetQuantity()
		self.market.SuppressPurchaseEnter()
		self.Close()
		self.market.SendStackPurchase(data, quantity)

	def OnPressReturnKey(self):
		if not self.data:
			return False
		self.Accept()
		return True

	def Close(self):
		self.quantityEdit.KillFocus()
		self.data = None
		self.Hide()

	def OnPressEscapeKey(self):
		self.Close()
		return True
import math

def GetProgressClamped01(val, maxVal):
    if maxVal == 0:
        return 0
    return min(float(val) / maxVal, 1)

def Clamp01(val):
    return min(max(val, 0.0), 1.0)











def GetLerp(v1, v2, t):
    delta = v2 - v1
    return v1 + delta * t

def GetEaseInCirc(v):
    return 1 - math.sqrt(1-math.pow(v, 2))

def GetEaseInQuint(v):
    return math.pow(v, 4)

def GetEaseOutCirc(v):
    return math.sqrt(1 - math.pow(v-1, 2))

def GetEaseInExpo(v):
    if v > 0:
        return math.pow(2, 10 * v - 10)
    return v

def GetEaseOutExpo(v):
    if v < 1:
        return math.pow(2, -10 * v)
    return v

def binomial_coefficient(n, k):
    """
    Calculate binomial coefficient (n choose k).

    Parameters:
        n (int): Total number of items.
        k (int): Number of items to choose.

    Returns:
        int: Binomial coefficient value.
    """
    result = 1
    for i in range(1, k + 1):
        result = result * (n - i + 1) // i
    return result


def bezier(t, *values):
    """
    Compute a point on a Bezier curve.

    Parameters:
        t (float): Parameter ranging from 0 to 1.
        *points (tuple or list): Control points.

    Returns:
        tuple or list: Interpolated point on the Bezier curve.
    """
    n = len(values) - 1
    u = 1 - t

    p = sum(binomial_coefficient(n, i) * t ** (n - i) * u ** i * values[i] for i in range(n + 1))

    return p


def bezier_rotation(t, *angles):
    """
    Interpolate rotation values using a Bezier curve.

    Parameters:
        t (float): Parameter ranging from 0 to 1.
        *angles (float): Control rotation values.

    Returns:
        float: Interpolated rotation value.
    """
    n = len(angles) - 1
    u = 1 - t

    
    angles = [(angle + 180) % 360 - 180 for angle in angles]

    
    for i in range(1, len(angles)):
        diff = angles[i] - angles[i - 1]
        if abs(diff) > 180:
            if diff > 0:
                angles[i] -= 360
            else:
                angles[i] += 360

    p = sum(binomial_coefficient(n, i) * t**(n-i) * u**i * angles[i] for i in range(n + 1))

    
    result = (p + 180) % 360 - 180

    return result

def interpolate_rotation(start, end, t):
    """
    Interpolate rotation values, handling wrapping around -180 to 180 range.

    Parameters:
        start (float): Starting rotation value.
        end (float): Ending rotation value.
        t (float): Interpolation parameter. Should be in the range [0, 1].

    Returns:
        float: Interpolated rotation value.
    """
    
    start = (start + 180) % 360 - 180
    end = (end + 180) % 360 - 180

    
    diff = end - start
    if abs(diff) > 180:
        if diff > 0:
            end -= 360
        else:
            end += 360

    
    result = start + t * (end - start)

    
    result = (result + 180) % 360 - 180

    return result
