	def __TargetHP(self, vid, hp, maxHp):
		try:
			vid = int(vid)
			hp = int(hp)
			maxHp = int(maxHp)
		except ValueError:
			return
		import uiautohunt
		uiautohunt.NoteHuntTargetHP(vid, hp)
		self.targetBoard.SetRealHP(vid, hp, maxHp)

