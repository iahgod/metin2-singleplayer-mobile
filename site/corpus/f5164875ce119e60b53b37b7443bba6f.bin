    ('ninja', tuple(BROWSER_ROWS[i] for i in (1081, 1216, 1217, 1218, 1219, 1220, 1221, 1222, 1223, 1224, 1225))),
    ('shaman', tuple(BROWSER_ROWS[i] for i in (1081, 1238, 1239, 1240, 1241, 1242, 1243, 1244, 1245, 1246, 1247, 1248, 1249))),
)
# Advanced auto-hunt loot rules. Python 2.7, ASCII / CP1250 UI escapes.
# Proto type/subtype rules are authoritative on the server. This index is UI only.
import hashlib
import os
import sys
import autohunt_item_catalog  

MAX_EXCEPTIONS = 8192
MAX_RULES = 512
WIRE_CHUNK = 180
SKILL_BOOK_RULE = 280
SKILL_BOOK_VNUM = 50300
FORGET_BOOK_RULE = 282
FORGET_BOOK_VNUM = 70037
CATEGORY_IDS = dict((key, 256 + i) for i, key in enumerate(
    ('weapon', 'armour', 'accessory', 'potion', 'book', 'stone', 'other')))


_groupSource = None
_groupDefinitions = ()
_groupKeys = {}
_classification = {}


def GroupDefinitions():
    global _groupSource, _groupDefinitions, _groupKeys, _classification
    import autohunt_item_catalog as catalogue
    source = getattr(catalogue, 'DISPLAY_GROUPS', ())
    if source is not _groupSource:
        _groupSource = source
        _groupDefinitions = tuple(dict(g, types=frozenset(g['types']),
            pairs=frozenset(tuple(p) for p in g['pairs']), vnums=frozenset(g['vnums']),
            exclude_pairs=frozenset(tuple(p) for p in g.get('exclude_pairs', ())),
            exclude_groups=frozenset(g.get('exclude_groups', ()))) for g in source)
        _groupKeys = dict((g['key'],g) for g in _groupDefinitions)
        _classification = {}
    return _groupDefinitions


def Classification(kind, subtype, vnum=0):
    definitions = GroupDefinitions()
    key = (kind, subtype, vnum)
    if key in _classification:
        return _classification[key]
    base = BaseCategory(kind, subtype)
    result = [g for g in definitions if not g.get('retired') and
              (kind in g['types'] or (kind,subtype) in g['pairs'] or vnum in g['vnums'] or
               (g.get('fallback') and base == 'other')) and (kind,subtype) not in g['exclude_pairs']]
    if result:
        keys = frozenset(g['key'] for g in result)
        result = [g for g in result if not keys.intersection(g['exclude_groups'])]
        priority = min(g.get('priority',0) for g in result)
        result = [g for g in result if g.get('priority',0) == priority]
    value = (tuple(g['key'] for g in result) or ((kind,subtype),), result[0]['category'] if result else base)
    if len(_classification) < 8192:
        _classification[key] = value
    return value


def DisplayGroups(kind, subtype, vnum=0):
    return list(Classification(kind, subtype, vnum)[0])


def DisplayGroup(kind, subtype, vnum=0):
    return Classification(kind, subtype, vnum)[0][0]


def DisplayRule(group):
    GroupDefinitions()
    if group in _groupKeys:
        return (_groupKeys[group]['rule_id'], -1)
    return group


def CategoryDisplayRules(category):
    return [(group['rule_id'], -1) for group in GroupDefinitions()
            if group['category'] == category and not group.get('retired')]


def Category(kind, subtype, vnum=0):
    return Classification(kind, subtype, vnum)[1]


def DisplayPlacements(kind, subtype, vnum=0):
    groups, category = Classification(kind, subtype, vnum)
    return tuple((_groupKeys[g]['category'] if g in _groupKeys else category, g) for g in groups)


def Categories(kind, subtype, vnum=0):
    return frozenset(category for category, group in DisplayPlacements(kind, subtype, vnum))


def BaseCategory(kind, subtype):
    if kind == 1:
        return 'weapon'
    if kind == 2:
        return 'armour' if subtype in (0, 1, 2) else 'accessory'
    if kind in (33, 34):
        return 'accessory'
    if ((kind == 3 and subtype in (0, 7, 11, 16)) or
            (kind == 4 and subtype in (0, 1)) or kind in (27, 36)):
        return 'potion'
    if kind in (17, 22):
        return 'book'
    if kind == 10:
        return 'stone'
    return 'other'


def BookSkillRule(vnum, kind):
    if vnum == SKILL_BOOK_VNUM and kind == 17: return SKILL_BOOK_RULE
    if vnum == FORGET_BOOK_VNUM and kind == 22: return FORGET_BOOK_RULE
    return 0


def ValidRule(rule):
    import autohunt_item_catalog as catalogue
    return (len(rule) == 2 and 0 <= rule[0] <= getattr(catalogue, 'MAX_RULE_KIND', 262) and -1 <= rule[1] <= 255 and
            (rule[0] <= 255 or rule[1] == -1 or (rule[0] in (SKILL_BOOK_RULE,FORGET_BOOK_RULE) and rule[1] > 0)))


def RuleMatches(rules, kind, subtype, vnum=0):
    groups, baseCategory = Classification(kind, subtype, vnum)
    found, allowed = False, False
    for group in groups:
        definition = _groupKeys.get(group)
        if definition is None:
            continue
        choice = rules.get((definition['rule_id'], -1))
        if choice is not None:
            found, allowed = True, allowed or choice
    if found:
        return allowed
    for rule in ((kind, subtype), (kind, -1)):
        choice = rules.get(rule)
        if choice is not None:
            return choice
    for group in groups:
        definition = _groupKeys.get(group)
        category = definition['category'] if definition is not None else baseCategory
        if rules.get((CATEGORY_IDS[category], -1), False):
            return True
    return False


def Excluded(vnum, kind, family=0, subtype=-1, antiflag=0):
    import autohunt_item_catalog as catalogue
    if antiflag:
        exceptions = getattr(catalogue, 'ANTIFLAG_EXCEPTIONS', None)
        if exceptions:
            antiflag &= ~exceptions.get((vnum, kind, subtype), 0)
    return (vnum in getattr(catalogue, 'EXCLUDED_VNUMS', ()) or
            kind in getattr(catalogue, 'EXCLUDED_TYPES', ()) or
            (kind, subtype) in getattr(catalogue, 'EXCLUDED_TYPE_SUBTYPES', ()) or
            bool(antiflag & getattr(catalogue, 'EXCLUDED_ANTIFLAGS', 0)) or
            family in getattr(catalogue, 'EXCLUDED_FAMILIES', ()))


def CanonicalFamily(family):
    import autohunt_item_catalog as catalogue
    return getattr(catalogue, 'FAMILY_ALIASES', {}).get(family, family)


class Settings(object):
    def __init__(self):
        self.minBonus = 0
        self.pickup = None  
        self.manualFilter = None  
        self.rules = {}
        self.include = set()
        self.exclude = set()
        self.families = {}  

    def Wants(self, vnum, kind, subtype, family=0, grade=-1, bookSkill=0):
        family = CanonicalFamily(family)
        if Excluded(vnum, kind, family, subtype):
            return False
        if vnum in self.exclude:
            return False
        skillRule=BookSkillRule(vnum,kind)
        if skillRule and (skillRule, bookSkill) in self.rules:
            return self.rules[skillRule, bookSkill]
        familyChoice = self.families.get(family)
        if familyChoice is not None:
            selected, minimum = familyChoice
            if grade < minimum:
                return False
            if vnum in self.include:
                return True
            return selected
        return vnum in self.include or RuleMatches(self.rules, kind, subtype, vnum)

    def SetFamily(self, base, selected, minimum, members):
        base = CanonicalFamily(base)
        if not 0 <= minimum <= 19 or not 0 < base <= 0xffffffff:
            raise ValueError('Invalid refine family rule')
        for vnum, grade in members:
            self.include.discard(vnum)
            self.exclude.discard(vnum)
        self.families[base] = (bool(selected), minimum)

    def ClearBookSkills(self, vnum=None):
        kinds=(SKILL_BOOK_RULE,FORGET_BOOK_RULE) if vnum is None else (
            SKILL_BOOK_RULE if vnum == SKILL_BOOK_VNUM else FORGET_BOOK_RULE,)
        for rule in list(self.rules):
            if rule[0] in kinds and rule[1] > 0:
                del self.rules[rule]

    def SetBookSkill(self, skill, selected, vnum=SKILL_BOOK_VNUM):
        if not 1 <= skill <= 255:
            raise ValueError('Invalid skill book choice')
        rule=BookSkillRule(vnum,17 if vnum == SKILL_BOOK_VNUM else 22)
        if not rule: raise ValueError('Unsupported socket book')
        if not any(key[0] == rule and key[1] > 0 for key in self.rules):
            
            
            baseline = self.Wants(vnum,17 if vnum == SKILL_BOOK_VNUM else 22,0)
            self.include.discard(vnum)
            self.exclude.discard(vnum)
            self.families.pop(vnum, None)
            self.SetRule((rule, -1), baseline)
        self.SetRule((rule, skill), selected)

    def ToggleItem(self, vnum, kind, subtype):
        if BookSkillRule(vnum,kind):
            self.ClearBookSkills(vnum)
        selected = self.Wants(vnum, kind, subtype)
        
        self.include.discard(vnum)
        self.exclude.discard(vnum)
        if selected and RuleMatches(self.rules, kind, subtype, vnum):
            self.exclude.add(vnum)
        elif not selected and not RuleMatches(self.rules, kind, subtype, vnum):
            self.include.add(vnum)

    def SetRule(self, rule, enabled):
        if not ValidRule(rule):
            raise ValueError('Invalid loot rule')
        self.rules[rule] = bool(enabled)

    def Text(self):
        text = ('version=3\nmin_bonus=%d\nrules=%s\ninclude=%s\nexclude=%s\nfamilies=%s\n' %
                (self.minBonus,
                 ','.join('%d:%d:%d' % (r[0], r[1], self.rules[r]) for r in sorted(self.rules)),
                 ','.join(str(v) for v in sorted(self.include)),
                 ','.join(str(v) for v in sorted(self.exclude)),
                 ','.join('%d:%d:%d' % (v, self.families[v][0], self.families[v][1]) for v in sorted(self.families))))
        if self.pickup is not None:
            text += 'pickup=%d\n' % self.pickup
        if self.manualFilter is not None:
            text += 'manual_filter=%d\n' % self.manualFilter
        return text

    @classmethod
    def FromText(cls, text):
        values = dict(line.split('=', 1) for line in text.splitlines() if '=' in line)
        if values.get('version') not in ('1', '2', '3'):
            raise ValueError('Unsupported advanced loot settings')
        if any(key not in values for key in ('rules', 'include', 'exclude')):
            raise ValueError('Incomplete advanced loot settings')
        result = cls()
        if 'pickup' in values:
            if values['pickup'] not in ('0', '1'):
                raise ValueError('Invalid automatic pickup setting')
            result.pickup = int(values['pickup'])
        if 'manual_filter' in values:
            if values['manual_filter'] not in ('0', '1'):
                raise ValueError('Invalid manual pickup filter setting')
            result.manualFilter = int(values['manual_filter'])
        if values['version'] == '3':
            minimum = values.get('min_bonus', '')
            if not minimum.isdigit() or not 0 <= int(minimum) <= 7:
                raise ValueError('Invalid minimum bonus count')
            result.minBonus = int(minimum)
        else:
            if values.get('enabled') not in ('0', '1') or values.get('two_bonus') not in ('0', '1'):
                raise ValueError('Incomplete advanced loot settings')
            result.minBonus = 2 if values['two_bonus'] == '1' else 0
        for entry in values.get('rules', '').split(','):
            if not entry:
                continue
            fields = tuple(int(v) for v in entry.split(':'))
            rule = fields[:2]
            if len(fields) != 3 or not ValidRule(rule) or fields[2] not in (0, 1):
                raise ValueError('Invalid loot rule')
            result.rules[rule] = bool(fields[2])
        for key in ('include', 'exclude'):
            selected = set(int(v) for v in values.get(key, '').split(',') if v)
            if any(v <= 0 or v > 0xffffffff for v in selected):
                raise ValueError('Invalid loot vnum')
            setattr(result, key, selected)
        if values['version'] in ('2', '3') and 'families' not in values:
            raise ValueError('Incomplete family settings')
        for entry in values.get('families', '').split(','):
            if not entry:
                continue
            fields = tuple(int(v) for v in entry.split(':'))
            if len(fields) != 3 or not 0 < fields[0] <= 0xffffffff or fields[1] not in (0, 1) or not 0 <= fields[2] <= 19:
                raise ValueError('Invalid family setting')
            base = CanonicalFamily(fields[0])
            selected, minimum = bool(fields[1]), fields[2]
            if base in result.families:
                
                selected = selected and result.families[base][0]
                minimum = max(minimum, result.families[base][1])
            result.families[base] = (selected, minimum)
        if len(result.rules) > MAX_RULES or len(result.include) + len(result.exclude) + len(result.families) > MAX_EXCEPTIONS:
            raise ValueError('Too many loot rules')
        return result


def ServerIdentity(net):
    
    
    try:
        name = net.GetServerInfo().split(',')[0].strip()
    except (AttributeError, TypeError):
        name = 'local'
    for moduleName in ('serverInfo', 'serverinfo'):
        module = sys.modules.get(moduleName)
        for server in getattr(module, 'SERVER_LIST', {}).values():
            main = server.get('main', {})
            if main.get('name', '').strip() == name:
                return '%s|%s|%s' % (name, main.get('host', ''), main.get('auth_base_port', ''))
    return name


def _Digest(text):
    if not isinstance(text, bytes):
        text = text.encode('utf-8')
    return hashlib.sha256(text).hexdigest()


def ConfigPath(server, character):
    return os.path.join('autohunt', 'advanced', _Digest(server), _Digest(character) + '.cfg')


def ProfilePath(server, character, slot):
    if slot not in range(1, 7):
        raise ValueError('Invalid filter profile slot')
    return os.path.join(os.path.splitext(ConfigPath(server, character))[0], 'profiles', '%d.cfg' % slot)


def Load(path, requirePickup=False):
    for candidate in (path, path + '.bak'):
        if not os.path.exists(candidate):
            continue
        try:
            with open(candidate, 'r') as handle:
                state = Settings.FromText(handle.read())
            if requirePickup and state.pickup is None:
                raise ValueError('Incomplete filter profile')
            return state, True
        except (IOError, OSError, ValueError, TypeError):
            pass
    if os.path.exists(path) or os.path.exists(path + '.bak'):
        
        state = Settings()
        return state, False
    return Settings(), True


def Save(path, state):
    temporary, backup = path + '.tmp', path + '.bak'
    try:
        directory = os.path.dirname(path)
        if not os.path.isdir(directory):
            os.makedirs(directory)
        with open(temporary, 'w') as handle:
            handle.write(state.Text())
            handle.flush()
            os.fsync(handle.fileno())
        if os.path.exists(path):
            if os.path.exists(backup):
                os.remove(backup)
            os.rename(path, backup)
        os.rename(temporary, path)
        return True
    except (IOError, OSError):
        return False


def Chunks(entries):
    chunk = ''
    for entry in entries:
        if chunk and len(chunk) + len(entry) + 1 > WIRE_CHUNK:
            yield chunk
            chunk = ''
        chunk += (',' if chunk else '') + entry
    if chunk:
        yield chunk


class Sync(object):
    """Transactional sync through /autohunt_loot, paced by Hunter.CommandGapOk.

    A numeric loot request carries the acknowledged revision. An old server
    cannot acknowledge it, so advanced collection stays stopped.
    """
    def __init__(self):
        self.revision = 0
        self.Invalidate()

    def Invalidate(self):
        self.revision = self.revision % 0x7ffffffe + 1
        self.ready = False
        self.queue = None
        self.cursor = 0
        self.waitUntil = 0.0
        self.warned = False

    def Build(self, state):
        r = self.revision
        commands = ['/autohunt_loot begin2 %d %d %d %d %d %d' %
                    (r, len(state.rules), len(state.include), len(state.exclude), state.minBonus, len(state.families))]
        for verb, entries in (
                ('rules', ('%d:%d:%d' % (r[0], r[1], state.rules[r]) for r in sorted(state.rules))),
                ('include', (str(v) for v in sorted(state.include))),
                ('exclude', (str(v) for v in sorted(state.exclude))),
                ('families', ('%d:%d:%d' % (v, state.families[v][0], state.families[v][1]) for v in sorted(state.families)))):
            for chunk in Chunks(entries):
                commands.append('/autohunt_loot %s %d %s' % (verb, r, chunk))
        commands.append('/autohunt_loot commit %d' % r)
        self.queue = commands
        self.cursor = 0

    def Step(self, state, now, send, gapOk):
        if self.ready:
            return True
        if self.queue is None:
            self.Build(state)
        if self.queue and gapOk:
            send(self.queue[self.cursor], now)
            self.cursor += 1
            if self.cursor == len(self.queue):
                self.queue = []
                self.waitUntil = now + 5.0
        elif not self.queue and now >= self.waitUntil:
            if not self.warned:
                self.warned = True
                return 'timeout'
        return False

    def Ack(self, revision, status):
        try:
            matches = int(revision) == self.revision
        except (ValueError, TypeError):
            return
        if matches and self.queue == []:
            self.ready = status == 'ok'


def CatalogueRows():
    
    
    from autohunt_item_catalog import ITEM_ROWS
    known = dict((r[0], (r[1], r[2])) for r in ITEM_ROWS)
    seen = set()
    for vnum, kind, subtype, span in ITEM_ROWS:
        for exact in range(vnum, vnum + span + 1):
            if exact in seen:
                continue
            seen.add(exact)
            actual = known.get(exact, (kind, subtype))
            if Excluded(exact, actual[0], subtype=actual[1]):
                continue
            yield exact, actual[0], actual[1]


CatalogueRows.prepared = True


def RefineCatalogue():
    import autohunt_item_catalog
    if hasattr(autohunt_item_catalog, 'BROWSER_REFINE_INFO'):
        return autohunt_item_catalog.BROWSER_REFINE_INFO, autohunt_item_catalog.BROWSER_FAMILIES
    info = dict((vnum, data) for vnum, data in getattr(autohunt_item_catalog, 'REFINE_INFO', {}).items()
                if not Excluded(vnum, -1, data[0]))
    members = {}
    for vnum, (base, grade) in info.items():
        members.setdefault(base, []).append((vnum, grade))
    return info, dict((base, tuple(sorted(values, key=lambda v: (v[1],v[0])))) for base, values in members.items())


import chr
import clientclock
import math
import player
import sys

TARGET_LOAD_GRACE = 0.3
DEATH_CONFIRM_SECONDS = 0.5
POST_KILL_SECONDS = 2.0

def Core():
    import uiautohunt
    return uiautohunt

def IsPolymorphed():
    affect = getattr(chr, 'NEW_AFFECT_POLYMORPH', None)
    affects = Core().AffectDict()
    if affect is not None and affects is not None and affect in affects:
        return True
    for name in ('IsPolymorphed', 'IsPolymorph'):
        ask = getattr(player, name, None)
        if ask is not None:
            try:
                if ask():
                    return True
            except (RuntimeError, TypeError):
                pass
    return False

def TargetDead(vid):
    
    
    ask = getattr(player, 'IsTargetDead', None)
    return bool(ask is not None and ask(vid))

def HorseSummoned():
    module = sys.modules.get('constInfo')
    return bool(module is not None and getattr(module, 'IS_HORSE_SUMMONED', False))

class HuntBehaviour(object):
    def ResetBehaviour(self):
        self.customPendingTarget = (0, 0.0)
        self.targetMissingVid, self.targetMissingSince = 0, None
        self.manualMoveKeys = set()
        self.manualAttackHeld = self.manualMouseHeld = False
        self.manualPoint, self.manualLastPosition = None, None
        self.manualProgressAt = self.manualUntil = 0.0
        self.riderManualFoot = False
        self.manualHorseExpected, self.manualHorseUntil = None, 0.0
        self.polymorphActive = self.polymorphResumeHorse = False
        self.lastMountedState = False
        self.behaviourFrame = False
        self.nextPolymorphHorseSummon = 0.0
        self.rangeCircleNeedsReset, self.rangeCircleKey = True, None
        self.ResetKillState()

    def PolymorphBlocksActions(self):
        return self.polymorphActive if self.behaviourFrame else IsPolymorphed()

    def ResetKillState(self):
        self.postKillWatchVid = self.postKillHandledVid = 0
        self.postKillConfirmingVid = 0
        self.postKillDeathSince, self.postKillHP = {}, {}
        self.postKillLootUntil = 0.0

    def TargetReady(self, vid):
        return self.TargetDistance(vid) >= 0

    def TargetDistance(self, vid):
        return player.GetCharacterDistance(vid) if vid and chr.HasInstance(vid) else -1

    def PrepareTargetReply(self, value, now):
        vid = Core().ParseTargetVid(value)
        if not vid or self.ManualControlActive(now):
            return 0
        if not self.TargetReady(vid):
            if self.customPendingTarget[0] != vid:
                self.customPendingTarget = (vid, now + TARGET_LOAD_GRACE)
            return 0
        if not self.TargetInsideHunt(vid):
            return 0
        if now < self.postKillLootUntil:
            reach = self.RiderReach() if Core().IsMounted() else self.Reach()
            if player.GetCharacterDistance(vid) > reach:
                return 0
        self.customPendingTarget = (0, 0.0)
        if not self.postKillWatchVid and self.ImportantLootTarget(vid):
            self.postKillWatchVid = vid
        return vid

    def RetryPendingTarget(self, now):
        vid, deadline = self.customPendingTarget
        if not vid:
            return
        if now >= deadline or not self.running or not self.config.get('attack'):
            self.customPendingTarget = (0, 0.0)
            self.nextRequest = min(self.nextRequest, now + TARGET_LOAD_GRACE)
        elif self.TargetReady(vid):
            self.customPendingTarget = (0, 0.0)
            self.OnServerTarget(vid)

    def TargetLoadPending(self, vid, now):
        if not vid:
            return False
        if self.targetMissingVid != vid or self.targetMissingSince is None:
            self.targetMissingVid, self.targetMissingSince = vid, now
        self.ReleaseAttack()
        return now - self.targetMissingSince < TARGET_LOAD_GRACE

    def HaltAutoMotion(self):
        Core().ClearReservedAction()
        x, y = player.GetMainCharacterPosition()[:2]
        chr.MoveToDestPosition(player.GetMainCharacterIndex(), int(x), int(y))

    def BeginManualControl(self):
        if not self.running:
            return
        if not self.ManualControlActive(clientclock.Now()):
            self.ResetKiting(stop=True)
            self.ReleaseAttack()
            self.HaltAutoMotion()
            self.ResetNavigation()
            self.ResetEscape()
            self.ResetChaseMovement()
            self.targetVid = self.lootVid = 0
            self.lootSweeping = False
            self.customPendingTarget = (0, 0.0)
            self.ResetKillState()

    def ManualKey(self, key, held):
        if not self.running:
            return
        if held:
            self.BeginManualControl()
            self.manualPoint = None
            self.manualMoveKeys.add(key)
        else:
            self.manualMoveKeys.discard(key)
            self.manualUntil = clientclock.Now() + 0.15

    def ManualAttack(self, held):
        if not self.running:
            return
        if held:
            self.BeginManualControl()
        self.manualAttackHeld = bool(held)
        self.attacking = bool(held)
        if not held:
            self.manualUntil = clientclock.Now() + 0.15

    def ManualGround(self, point):
        if not self.running:
            return
        self.BeginManualControl()
        if point is not None and any(math.isnan(value) or math.isinf(value) for value in point):
            point = None
        self.manualPoint, self.manualMouseHeld = point, True
        self.manualLastPosition = player.GetMainCharacterPosition()[:2]
        self.manualProgressAt = clientclock.Now()

    def ManualMouseRelease(self):
        self.manualMouseHeld = False

    def ClearManualControl(self):
        self.manualMoveKeys.clear()
        self.manualPoint = None
        self.manualMouseHeld = self.manualAttackHeld = False
        self.manualUntil = 0.0

    def ManualControlActive(self, now):
        return bool(self.manualMoveKeys or self.manualAttackHeld or self.manualMouseHeld or
                    self.manualPoint is not None or now < self.manualUntil)

    def ManualControlFrame(self, now):
        point = self.manualPoint
        if point is not None and not self.manualMouseHeld:
            x, y = player.GetMainCharacterPosition()[:2]
            lx, ly = self.manualLastPosition
            if (x-lx)**2 + (y-ly)**2 > 25:
                self.manualLastPosition, self.manualProgressAt = (x,y), now
            if (point[0]-x)**2 + (point[1]-y)**2 <= 80**2 or now-self.manualProgressAt >= 2.0:
                self.manualPoint = None
        if self.ManualControlActive(now):
            if self.manualAttackHeld and not self.attacking:
                player.SetAttackKeyState(True)
                self.attacking = True
            elif not self.manualAttackHeld:
                self.ReleaseAttack()
            return True
        return False

    def ManualHorseToggle(self):
        if not self.running:
            return
        mounted = Core().IsMounted()
        self.ReleaseAttack()
        Core().ClearReservedAction()
        self.ResetRider()
        self.riderManualFoot = bool(mounted)
        self.manualHorseExpected = not mounted
        self.manualHorseUntil = clientclock.Now() + 3.0
        self.riderSaddle = not mounted
        if IsPolymorphed():
            self.polymorphResumeHorse = not mounted
            self.manualHorseExpected = None
        self.ResetChaseMovement()

    def ManualHorseFrame(self, now):
        expected = self.manualHorseExpected
        if expected is None:
            return False
        mounted = Core().IsMounted()
        if mounted != expected and now < self.manualHorseUntil:
            return True
        self.manualHorseExpected = None
        self.riderManualFoot = not mounted
        self.riderSaddle = mounted
        if mounted:
            self.RiderInSaddle(now)
        return False

    def UpdatePolymorphMode(self, now):
        transformed = IsPolymorphed()
        mounted = Core().IsMounted()
        wasMounted, self.lastMountedState = self.lastMountedState, mounted
        if transformed == self.polymorphActive:
            return
        resume = self.polymorphResumeHorse
        if transformed:
            resume = bool(not self.riderManualFoot and
                          (self.riderSaddle or self.riderWasMounted or wasMounted or mounted or self.config.get('rider')))
        self.polymorphActive, self.polymorphResumeHorse = transformed, resume
        self.ResetKiting(stop=True)
        self.ReleaseAttack()
        Core().ClearReservedAction()
        self.ResetChaseMovement()
        self.ResetRider()
        self.manualHorseExpected = None
        self.buffing, self.buffPending, self.buffVerify = False, None, {}
        self.skillHoldUntil = 0.0
        self.nextRequest = now
        if not transformed:
            self.riderSaddle = bool(self.running and resume and not self.riderManualFoot)
            self.riderNeedsSummon = self.riderSaddle and not Core().IsMounted()
            self.mountedSkillCycle = bool(self.riderNeedsSummon and not self.config.get('rider'))
            self.polymorphResumeHorse = False

    def PolymorphHorseFollowerFrame(self, now):
        if (not self.polymorphActive or not self.polymorphResumeHorse or Core().IsMounted() or
                HorseSummoned() or now < self.nextPolymorphHorseSummon):
            return
        self.nextPolymorphHorseSummon = now + 5.0
        self.riderNeedsSummon = True
        self.RiderSummon(now)

    def NoteHuntTargetHP(self, value, hp, actual=True):
        vid = Core().ParseTargetVid(value)
        if not actual or not self.running or vid not in (self.targetVid, self.postKillWatchVid) or not vid:
            return
        try:
            hp = int(hp)
            self.postKillHP[vid] = (hp, clientclock.Now())
            if hp > 0:
                self.postKillDeathSince.pop(vid, None)
        except (TypeError, ValueError, OverflowError):
            pass

    def ImportantLootTarget(self, vid):
        if not vid or not chr.HasInstance(vid):
            return False
        if chr.GetInstanceType(vid) == getattr(chr, 'INSTANCE_TYPE_STONE', 2):
            return True
        try:
            import nonplayer
            return nonplayer.GetGradeByVID(vid) >= nonplayer.BOSS
        except (ImportError, AttributeError, RuntimeError):
            return False

    def ConfirmedHuntDeath(self, vid, now):
        if not vid:
            return False
        if chr.HasInstance(vid):
            if not TargetDead(vid):
                self.postKillDeathSince.pop(vid, None)
                self.postKillHP.pop(vid, None)
                return False
        elif vid not in self.postKillDeathSince:
            hp, at = self.postKillHP.get(vid, (-1, -1000.0))
            if hp != 0 or now-at > 2.0:
                return False
        
        if vid not in self.postKillDeathSince:
            self.postKillDeathSince[vid] = now
        return now-self.postKillDeathSince[vid] >= DEATH_CONFIRM_SECONDS

    def PostKillLootFrame(self, now):
        watched = (self.postKillWatchVid, self.targetVid)
        self.postKillDeathSince = dict((vid,at) for vid,at in self.postKillDeathSince.items() if vid in watched)
        self.postKillHP = dict((vid,hp) for vid,hp in self.postKillHP.items() if vid in watched)
        waiting = 0
        for vid in set(watched):
            if not vid or vid == self.postKillHandledVid:
                continue
            if vid != self.postKillWatchVid and not self.ImportantLootTarget(vid):
                continue
            if self.ConfirmedHuntDeath(vid, now):
                self.postKillHandledVid, self.postKillWatchVid = vid, 0
                self.postKillConfirmingVid = 0
                if self.targetVid == vid:
                    self.targetVid = 0
                self.ReleaseAttack()
                self.HaltAutoMotion()
                self.ResetNavigation()
                self.ResetEscape()
                self.ResetChaseMovement()
                self.lootSweeping = False
                self.lootVid = 0
                self.customPendingTarget = (0, 0.0)
                self.nextRequest = self.nextLootRequest = now
                state = self.advancedLoot
                selected = state.include or any(state.rules.values()) or any(choice[0] for choice in state.families.values())
                self.postKillLootUntil = now + POST_KILL_SECONDS if self.CurrentLootMask() and selected else 0.0
                break
            if vid in self.postKillDeathSince:
                waiting = vid
        if self.targetVid and self.TargetReady(self.targetVid) and not TargetDead(self.targetVid):
            if self.ImportantLootTarget(self.targetVid):
                self.postKillWatchVid = self.targetVid
            if self.postKillHandledVid == self.targetVid:
                self.postKillHandledVid = 0
        if waiting and not self.postKillLootUntil:
            self.ReleaseAttack()
            if self.postKillConfirmingVid != waiting:
                self.HaltAutoMotion()
                self.postKillConfirmingVid = waiting
            return True
        if not waiting:
            self.postKillConfirmingVid = 0
        if now >= self.postKillLootUntil:
            if self.postKillLootUntil:
                self.postKillLootUntil = 0.0
                self.nextRequest = self.nextLootRequest = now
                if self.targetVid and (not self.TargetReady(self.targetVid) or TargetDead(self.targetVid)):
                    self.targetVid = 0
            return False
        self.RiderLoot(now)
        self.PostKillStationaryCombat(now)
        return True

    def PostKillStationaryCombat(self, now):
        core = Core()
        reach = self.RiderReach() if core.IsMounted() else self.Reach()
        if self.config.get('attack') and now >= self.nextRequest and self.CommandGapOk(now):
            self.nextRequest = now + core.TARGET_REQUEST_INTERVAL
            dx, dy = self.AnchorOffset()
            self.Command('/autohunt_target %d %d %d %d %d %d 0 1' %
                         (int(reach), self.config.get('stones',0), dx, dy,
                          self.config.get('mobs',1), self.config.get('bosses',0)), now)
        vid = self.targetVid
        if (not self.config.get('attack') or not self.TargetReady(vid) or TargetDead(vid) or
                player.GetCharacterDistance(vid) > reach or not self.TargetInsideHunt(vid) or now < self.skillHoldUntil):
            self.ReleaseAttack()
            return
        if now >= self.nextFace:
            self.nextFace = now + core.FACE_INTERVAL
            self.Face(vid)
        if player.GetTargetVID() != vid and now >= self.riderNextMark:
            self.riderNextMark = now + core.RIDER_MARK_INTERVAL
            player.SetTarget(vid)
        if not self.attacking:
            core.ClearReservedAction()
            player.SetAttackKeyState(True)
            self.attacking = True

    def ReturnSwitched(self):
        x, y = player.GetMainCharacterPosition()[:2]
        self.anchor = (int(x), int(y))
        wasReturning = self.returning
        self.returning, self.returnTrail = False, []
        self.ResetReturnMovement()
        if self.pathPurpose == 'return':
            self.ResetPath()
        if self.escapePurpose == 'return':
            self.ResetEscape()
        if wasReturning:
            self.HaltAutoMotion()
        self.nextMove = self.nextRequest = self.nextLootRequest = 0.0
        self.customPendingTarget = (0, 0.0)
        self.UpdateRangeCircle()

    def TargetInsideHunt(self, vid):
        if not self.config.get('return'):
            return True
        if not self.TargetReady(vid):
            return False
        x, y = chr.GetPixelPosition(vid)[:2]
        ax, ay = self.anchor
        return (x-ax)**2 + (y-ay)**2 <= self.config.get('range',2000)**2

    def ClampHuntPoint(self, x, y):
        if self.running and self.config.get('return'):
            if (x,y) == player.GetMainCharacterPosition()[:2]:
                return x, y
            ax, ay = self.anchor
            radius = max(0, self.config.get('range',2000)-40)
            dx, dy = x-ax, y-ay
            distance = math.sqrt(dx*dx+dy*dy)
            if distance > radius and distance:
                return ax+dx*radius/distance, ay+dy*radius/distance
        return x, y

    def UpdateRangeCircle(self):
        visible = self.running or (self.lootWindow and self.lootWindow.IsShow())
        key = None
        if visible:
            radius = self.config.get('range',2000)
            if self.running and self.config.get('return'):
                x, y = self.anchor
                key = (radius,float(x),float(y),1)
            elif self.RiderActive():
                key = (self.RiderRange(),0.0,0.0,0)
            else:
                key = (radius,0.0,0.0,0)
        if not self.rangeCircleNeedsReset and key == self.rangeCircleKey:
            return
        draw = getattr(player, 'SetAutoHuntRangeCircle', None)
        if draw is not None:
            if self.rangeCircleNeedsReset or key is None:
                draw(0)
            if key is not None:
                draw(*key)
        self.rangeCircleNeedsReset, self.rangeCircleKey = False, key

